---
// The TilePark app: feature cards on the left drive an animated phone mockup.
import { Icon } from 'astro-icon/components';
import Headline from '~/components/ui/Headline.astro';

const features = [
  {
    t: 0,
    icon: 'tabler:bell-ringing',
    title: 'Your valet, on call',
    text: 'Announce your departure, or schedule it in advance, and your car is waiting in the transfer cabin when you arrive. No queue, no keys to hand over, and the app learns your routine.',
  },
  {
    t: 5,
    icon: 'tabler:car',
    title: 'Manage your cars',
    text: 'Manage several vehicles and users in one account. Enter with a QR code, a secure access code or license-plate recognition, and request your car with one tap.',
  },
  {
    t: 2,
    icon: 'tabler:key',
    title: 'Welcome your guests',
    text: 'Grant friends, family and visitors access with a tap, for one evening or for good. They drive in, and you stay in control: revoke access at any time.',
  },
  {
    t: 3,
    icon: 'tabler:building',
    title: 'Fleets, company and hotel parking',
    text: 'An operator platform with user management, live dashboards and dynamic pricing for company vehicles, employee parking and hotel guests.',
  },
  {
    t: 1,
    icon: 'tabler:bolt',
    title: 'EV charging',
    text: 'Every space can be charge-ready. Set your target, and once charging is complete the system moves the car away, freeing the charger for the next vehicle.',
  },
  {
    t: 4,
    icon: 'tabler:credit-card',
    title: 'Payment',
    text: 'Parking, charging and guest access are paid in the app, for subscribers and occasional users alike, with every receipt in one place.',
  },
];
---

<div id="app-showcase" class="grid gap-12 lg:grid-cols-[1.25fr_0.9fr] lg:gap-16 items-center">
  <div>
    <Headline
      tagline="The TilePark app"
      title='Your personal valet, <span class="text-accent dark:text-white">in your pocket.</span>'
      subtitle="The app is the one part of TilePark that puts you at the center. Announce your departure, and your car is waiting in the transfer cabin when you get there. Invite friends and guests with a tap. Manage your cars, charging and payments in one place."
      classes={{ container: 'text-left rtl:text-right max-w-none md:mx-0', title: 'text-3xl md:text-4xl' }}
    />
    <div class="tp-app-feats">
      {
        features.map((f, i) => (
          <button
            data-t={f.t}
            class:list={[
              'rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm p-4',
              { on: i === 0 },
            ]}
          >
            <Icon name={f.icon} class="tp-ico w-9 h-9 p-2 text-white bg-primary rounded-full" />
            <b class="text-heading font-bold">{f.title}</b>
            <span class="tp-desc text-sm text-muted">{f.text}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="tp-phone-wrap order-first lg:order-none">
    <div class="tp-phone">
      <div class="ph-notch"></div>
      <div class="ph-head">
        <span class="ph-logo"
          ><svg width="14" height="14" viewBox="0 0 24 24"
            ><path d="M5 3h8a6 6 0 0 1 0 12H9v6H5z" fill="#93c5fd"></path></svg
          >TilePark</span
        ><span class="ph-site">Munich · 16 spaces</span>
      </div>
      <div class="ph-body">
        <!-- 0 valet -->
        <div class="scr on" data-s="0" id="valetScr">
          <h5>Good evening, Steffen</h5>
          <div class="pc pc-act">
            <span class="lbl">Your valet</span><b class="big">Audi A4 Avant</b><span>M-TP 2026 · charged to 80%</span>
            <div class="vl-steps">
              <div>Request received</div>
              <div>Moving through the grid</div>
              <div>Ready in the transfer cabin</div>
            </div>
            <button class="ph-btn" id="vlBtn">I'm leaving in 5 min</button>
          </div>
          <div class="pc">
            <span class="lbl">Tonight</span><b>Guest: Thomas arrives 7:00 PM</b><span
              >Access granted · space reserved</span
            >
          </div>
          <div class="toast" id="vlToast">
            <b>Your car is ready</b><span>Audi A4 Avant is waiting in transfer cabin 1.</span>
          </div>
        </div>
        <!-- 5 cars -->
        <div class="scr" data-s="5">
          <h5>My cars</h5>
          <div class="pc pc-act">
            <div class="pc-top"><b>Audi A4 Avant</b><em class="ok">Parked</em></div>
            <span>M-TP 2026 · Level 2</span>
            <div class="chg"><span>Charging</span><div class="bar"><i style="width:68%"></i></div><span>68%</span></div>
            <button class="ph-btn">Request car</button><span style="margin-top:.35rem;text-align:center"
              >Or show QR code at the cabin</span
            >
          </div>
          <div class="pc">
            <div class="pc-top"><b>Skoda Karoq</b><em class="ok">Parked</em></div><span>M-TP 1080 · Level 1</span>
          </div>
          <div class="pc">
            <div class="pc-top"><b>Mercedes A-Class</b><em class="out">Out</em></div><span
              >M-TP 4411 · Back 6:30 PM</span
            >
          </div>
        </div>
        <!-- 1 plan -->
        <div class="scr" data-s="1">
          <h5>Plan</h5>
          <div class="pc">
            <span class="lbl">Next departure</span><b class="big">Tomorrow, 7:30 AM</b><span
              >Audi A4 Avant · ready in the transfer cabin</span
            >
          </div>
          <div class="pc">
            <span class="lbl">EV charging</span>
            <div class="row"><b>Charge to 80%</b><span class="tg on"></span></div>
            <span>Done by 7:00 AM, then moved off the charger</span>
          </div>
          <div class="pc">
            <span class="lbl">Arrival</span>
            <div class="row"><b>Today, 6:30 PM</b><span class="tg on"></span></div>
            <span>Entry by license-plate recognition</span>
          </div>
          <div class="pc">
            <span class="lbl">Suggestion</span><b>You usually leave at 7:30 on weekdays</b><span
              >Schedule automatically?</span
            >
          </div>
        </div>
        <!-- 2 access -->
        <div class="scr" data-s="2">
          <h5>Access</h5>
          <div class="pc">
            <div class="row"><div><b>Lisa</b><span>Family · permanent</span></div><span class="tg on"></span></div>
          </div>
          <div class="pc">
            <div class="row">
              <div><b>Guest: Thomas</b><span>One visit · until 8:00 PM</span></div><span class="tg on"></span>
            </div>
          </div>
          <div class="pc">
            <div class="row">
              <div><b>Valet service</b><span>Weekdays · 7 AM to 7 PM</span></div><span class="tg on"></span>
            </div>
          </div>
          <div class="pc">
            <div class="row"><div><b>Former tenant</b><span>Access revoked</span></div><span class="tg"></span></div>
          </div>
          <button class="ph-btn ghost" id="invBtn">+ Invite a guest</button>
          <div class="toast" id="invToast">
            <b>Invitation sent to Anna</b><span>Access for Saturday · QR code shared</span>
          </div>
        </div>
        <!-- 3 fleet -->
        <div class="scr" data-s="3">
          <h5>Fleet</h5>
          <div class="kpis">
            <div><b>24</b><span>Vehicles</span></div><div><b>18</b><span>Parked</span></div><div>
              <b>6</b><span>Out</span>
            </div>
          </div>
          <div class="pc">
            <div class="pc-top"><b>Live occupancy</b><em class="ok">75%</em></div>
            <div class="bar" style="margin-top:.35rem"><i style="width:75%"></i></div>
          </div>
          <div class="pc">
            <div class="pc-top"><b>Company fleet</b><em class="ok">12 / 14</em></div><span
              >Pool cars · booked by employees</span
            >
          </div>
          <div class="pc">
            <div class="pc-top"><b>Employee parking</b><em class="ok">5 / 6</em></div><span>Assigned spaces</span>
          </div>
          <div class="pc">
            <div class="pc-top"><b>Hotel guests</b><em class="out">1 / 4</em></div><span
              >Access with booking · check-out 11 AM</span
            >
          </div>
        </div>
        <!-- 4 pay -->
        <div class="scr" data-s="4">
          <h5>Payment</h5>
          <div class="pc"><span class="lbl">Payment method</span><b>Visa ···· 4417</b></div>
          <div class="pc">
            <div class="pc-top"><b>Subscription</b><em class="ok">Active</em></div><span
              >Reserved space · billed monthly</span
            >
          </div>
          <div class="pc">
            <div class="pc-top"><b>Monthly parking</b><em class="ok">Paid</em></div><span>October · Audi A4 Avant</span>
          </div>
          <div class="pc">
            <div class="pc-top"><b>EV charging</b><em class="ok">Paid</em></div><span>18.4 kWh · Oct 29</span>
          </div>
          <div class="pc">
            <div class="pc-top"><b>Guest parking</b><em class="ok">Paid</em></div><span>Thomas · 3 h · Oct 27</span>
          </div>
        </div>
      </div>
      <div class="ph-tabs">
        <button data-t="0" class="on">Valet</button><button data-t="5">Cars</button><button data-t="1">Plan</button
        ><button data-t="2">Access</button><button data-t="3">Fleet</button><button data-t="4">Pay</button>
      </div>
    </div>
    <p class="mt-3 text-xs text-muted">Illustrative screens</p>
  </div>
</div>

<script>
  // eslint-disable-next-line @typescript-eslint/ban-ts-comment -- demo scripts ported from plain JavaScript
  // @ts-nocheck
  const root = document.getElementById('app-showcase');
  const screens = [...root.querySelectorAll('.scr')],
    tabs = [...root.querySelectorAll('.ph-tabs button')],
    feats = [...root.querySelectorAll('.tp-app-feats button')];
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  let cur = 0,
    auto = true,
    vis = false,
    running = false;
  function show(t, fromFeat) {
    cur = t;
    screens.forEach((s) => s.classList.toggle('on', +s.dataset.s === t));
    tabs.forEach((b) => b.classList.toggle('on', +b.dataset.t === t));
    if (!fromFeat) feats.forEach((b) => b.classList.toggle('on', +b.dataset.t === t));
    if (t === 0) playValet();
    if (t === 2) playInvite();
  }
  const steps = [...root.querySelectorAll('#valetScr .vl-steps div')],
    vb = document.getElementById('vlBtn'),
    vt = document.getElementById('vlToast');
  async function playValet() {
    if (running) return;
    running = true;
    steps.forEach((d) => d.classList.remove('on', 'cur'));
    vt.classList.remove('on');
    vb.textContent = "I'm leaving in 5 min";
    vb.style.opacity = 1;
    await sleep(900);
    vb.style.opacity = 0.55;
    vb.textContent = 'Requested ✓';
    for (let i = 0; i < 3; i++) {
      steps.forEach((d) => d.classList.remove('cur'));
      steps[i].classList.add('on', 'cur');
      await sleep(1100);
    }
    vt.classList.add('on');
    vb.textContent = 'Your car is ready';
    vb.style.opacity = 1;
    await sleep(2600);
    vt.classList.remove('on');
    running = false;
  }
  const ib = document.getElementById('invBtn'),
    it = document.getElementById('invToast');
  async function playInvite() {
    it.classList.remove('on');
    await sleep(1000);
    ib.style.background = 'var(--tp-accent-wash)';
    await sleep(400);
    it.classList.add('on');
    ib.style.background = '';
    await sleep(2600);
    it.classList.remove('on');
  }
  vb.onclick = () => {
    auto = false;
    playValet();
  };
  ib.onclick = () => {
    auto = false;
    playInvite();
  };
  tabs.forEach(
    (b) =>
      (b.onclick = () => {
        auto = false;
        show(+b.dataset.t);
      })
  );
  feats.forEach(
    (b) =>
      (b.onclick = () => {
        auto = false;
        feats.forEach((x) => x.classList.toggle('on', x === b));
        show(+b.dataset.t, true);
      })
  );
  new IntersectionObserver((e) => {
    vis = e[0].isIntersecting;
    if (vis && cur === 0) playValet();
  }).observe(root);
  const seq = [0, 2, 1, 5, 3, 4];
  let k = 0;
  setInterval(() => {
    if (auto && vis && !document.hidden && !running) {
      k = (k + 1) % seq.length;
      show(seq[k]);
    }
  }, 6500);
</script>
