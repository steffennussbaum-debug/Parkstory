---

<span class:list={['pk', `pk--${variant}`, cls]} role="img" aria-label="Parkstory" data-pk>
  <svg class="pk-P" viewBox="0 0 628 706" aria-hidden="true" set:html={variant === 'swarm' ? swarm : still} />
  {
    wordmark && (
      <span class="pk-rest" aria-hidden="true">
        arkstory
      </span>
    )
  }
</span>

<script>
  // Replay the swarm on click: re-insert the SVG so its CSS animations restart.
  document.querySelectorAll<HTMLElement>('.pk--swarm').forEach((el) => {
    el.style.cursor = 'pointer';
    el.title = 'Replay';
    el.addEventListener('click', () => {
      const svg = el.querySelector('svg');
      if (!svg) return;
      const copy = svg.cloneNode(true);
      svg.replaceWith(copy);
    });
  });
</script>

<style is:global>
  .pk {
    display: inline-flex;
    align-items: baseline;
    font-family: 'Outfit Variable', 'Outfit', Arial, sans-serif;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--pk-ink, #fff);
    white-space: nowrap;
  }
  .pk-P {
    height: 0.706em;
    width: 0.628em;
    flex: none;
    overflow: visible;
    margin-right: -0.03em;
  }
  /* --- swarm animation (Parkstory artwork) --- */
  .pk--swarm .bs-solid {
    animation: pkSolid 0.35s ease 1s forwards;
  }
  @keyframes pkSolid {
    to {
      opacity: 0;
    }
  }
  .pk--swarm .bs-d {
    transform-box: fill-box;
    transform-origin: center;
    animation: pkDots 3.8s cubic-bezier(0.35, 0.1, 0.25, 1) both;
  }
  @keyframes pkDots {
    0% {
      transform: none;
      opacity: 0;
      fill: #fff;
    }
    3% {
      opacity: 1;
      fill: #fff;
    }
    30% {
      transform: translate(var(--dx), var(--dy)) scale(0.55);
      fill: #fff;
    }
    62% {
      transform: translate(var(--mx), var(--my)) scale(0.75);
    }
    100% {
      transform: none;
      opacity: 1;
      fill: var(--c);
    }
  }
  .pk--swarm .bs-o2 {
    transform-origin: 330px 380px;
    opacity: 0;
    animation-name: pkOrbit, pkFade;
    animation-timing-function: linear, ease;
    animation-iteration-count: infinite, 1;
    animation-fill-mode: none, forwards;
    animation-delay: 0s, 4.6s;
  }
  @keyframes pkOrbit {
    from {
      transform: rotate(var(--ph));
    }
    to {
      transform: rotate(calc(var(--ph) + 360deg));
    }
  }
  @keyframes pkFade {
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pk--swarm .bs-solid {
      display: none;
    }
    .pk--swarm .bs-d,
    .pk--swarm .bs-o2 {
      animation: none;
    }
    .pk--swarm .bs-o2 {
      opacity: 0;
    }
  }
</style>
