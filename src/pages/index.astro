---
// Parkstory home page: "How TilePark works", rebuilt with AstroWind widgets.
// The interactive demos live in src/components/tilepark/.
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';

import BeesFigure from '~/components/tilepark/BeesFigure.astro';
import RealVideo from '~/components/tilepark/RealVideo.astro';
import GridDemo from '~/components/tilepark/GridDemo.astro';
import StackerDemo from '~/components/tilepark/StackerDemo.astro';
import EvDemo from '~/components/tilepark/EvDemo.astro';
import AppShowcase from '~/components/tilepark/AppShowcase.astro';
import FutureTimeline from '~/components/tilepark/FutureTimeline.astro';

import '~/assets/styles/tilepark.css';

const metadata = {
  title: 'Parkstory – How TilePark works',
  ignoreTitleTemplate: true,
  description:
    'TilePark XY: hundreds of independent conveyors, no central control, one shared goal: getting your car to you by the shortest route.',
};

// Emphasised words in headings use AstroWind's accent colour, like its own hero.
const em = (s: string) => `<span class="text-accent dark:text-white">${s}</span>`;

const beeRules = [
  {
    q: '“Don’t waste a single cell.”',
    bees: 'A honeycomb stores the most in the least space. No other shape divides an area into equal cells with less wall, a fact proven mathematically in 1999.',
    tp: 'Every position is a conveyor. No ramps, no driving lanes, no wasted floor.',
  },
  {
    q: '“Take the shortest way.”',
    bees: 'Bees learn the shortest route between flowers, even when they found them in a different order. Computers need to compare every route; bees do it with a brain the size of a grass seed.',
    tp: 'For every request, the system calculates the fastest route for the grid’s current layout. No two sequences are the same.',
  },
  {
    q: '“Nobody is in charge.”',
    bees: 'A hive has no boss and no master plan. Thousands of bees follow simple rules, and order emerges on its own.',
    tp: 'Each conveyor has its own controller and hands cars to its neighbors. No central computer, shuttle, or lift that every car depends on.',
  },
  {
    q: '“If a cell breaks, go around it.”',
    bees: 'Bees simply work around a damaged cell. The colony keeps going.',
    tp: 'If a conveyor goes offline, the others route around it, and every car stays accessible.',
  },
  {
    q: '“Keep getting better.”',
    bees: 'Bees refine their route with every flight and keep whatever is shorter.',
    tp: 'Every sequence teaches the system which routes and positions work best. The more it runs, the smarter it gets.',
  },
];

const plants = [
  {
    flag: 'DE',
    name: 'Kehl, Germany',
    text: 'Parkstory Manufacturing Kehl: approximately 10,000 m² of sheet-metal processing, welding, and assembly under one roof',
    pics: [
      {
        src: '~/assets/images/tilepark/kehl-plant.webp',
        alt: 'Aerial view of the Parkstory Manufacturing plant in Kehl',
        cap: 'Our plant in Kehl',
        pos: '50% 55%',
      },
      {
        src: '~/assets/images/tilepark/kehl-welding.webp',
        alt: 'CLOOS welding robot cell in Kehl',
        cap: 'Robotic welding',
        pos: '50% 35%',
      },
      {
        src: '~/assets/images/tilepark/kehl-bending.webp',
        alt: 'CNC press brake control panel in Kehl',
        cap: 'CNC bending',
        pos: '75% 55%',
      },
      {
        src: '~/assets/images/tilepark/kehl-steel.webp',
        alt: 'Galvanized steel frames in Kehl',
        cap: 'Galvanized steel',
        pos: '50% 50%',
      },
    ],
    caps: [
      'Coil processing and laser cutting',
      'CNC bending up to 6 m',
      'Robotic and manual welding',
      'CNC turning',
      'Steel structures and assembly',
      'Pre-assembly and functional testing',
    ],
  },
  {
    flag: 'US',
    name: 'Gastonia, North Carolina, USA',
    text: 'Production, machining, and assembly for North America: TilePark, built in the USA',
    pics: [
      {
        src: '~/assets/images/tilepark/gastonia-drive-assembly.webp',
        alt: 'TilePark conveyor drives with geared motors and polyurethane wheels in assembly in Gastonia',
        cap: 'TilePark conveyor drive assembly · Gastonia',
        pos: '50% 52%',
      },
      {
        src: '~/assets/images/tilepark/gastonia-plant.webp',
        alt: 'Parkstory plant in Gastonia, North Carolina',
        cap: 'Our plant',
        pos: '55% 60%',
      },
      {
        src: '~/assets/images/tilepark/gastonia-cnc.webp',
        alt: 'Haas CNC lathe with bar feeder in Gastonia',
        cap: 'CNC machining',
        pos: '50% 50%',
      },
      {
        src: '~/assets/images/tilepark/gastonia-wheels.webp',
        alt: 'Drive wheel units with yellow polyurethane wheels',
        cap: 'Drive wheel units',
        pos: '50% 50%',
      },
    ],
    caps: [
      'Fiber laser cutting with automatic shuttle table',
      'CNC press brake bending',
      'CNC turning and machining centers',
      'Welding and steel fabrication',
      'Conveyor drive assembly and testing',
      'Gantry and jib cranes for heavy assemblies',
    ],
  },
];

const flow = [
  'Design',
  'Controls',
  'Steel & cutting',
  'Welding',
  'Pre-assembly',
  '100% test',
  'Installation',
  'Service & 30+ years of parts',
];

const card = 'rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm';
const blueBg = '<div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>';
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>

  <!-- Hero ******************* -->
  <Hero
    tagline="TilePark XY"
    actions={[
      { variant: 'primary', text: 'See how it works', href: '#how-it-works', icon: 'tabler:arrow-down' },
      { text: 'Inspired by nature', href: '#inspired-by-nature' },
    ]}
    image={{
      src: '~/assets/images/tilepark/conveyors-installed.webp',
      alt: 'TilePark conveyors with their drives, installed in an underground garage',
    }}
  >
    <Fragment slot="title">
      Parking that <span class="text-accent dark:text-white">organizes itself.</span>
    </Fragment>
    <Fragment slot="subtitle">
      Hundreds of independent conveyors, no central control, one shared goal: getting your car to you by the shortest
      route. Here is how TilePark works, from the idea to the factory.
    </Fragment>
  </Hero>

  <!-- Inspired by nature ******************* -->
  <WidgetWrapper id="inspired-by-nature" containerClass="max-w-7xl">
    <Headline
      tagline="Inspired by nature"
      title={`We asked the bees ${em('how to park.')}`}
      subtitle="Bees have been solving our problem for millions of years: storing as much as possible in as little space as possible, and getting everywhere fast. So we asked them how they do it. Here are their five rules, and how TilePark follows each one."
    />
    <BeesFigure />

    <h3 class="mt-16 mb-6 text-center text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">
      The bees’ five rules for parking
    </h3>
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        beeRules.map((r, i) => (
          <li class={`${card} p-5 flex flex-col gap-3`}>
            <span class="flex w-8 h-8 items-center justify-center rounded-full bg-primary text-white text-sm font-bold">
              {i + 1}
            </span>
            <p class="font-heading text-lg font-bold leading-snug text-heading">{r.q}</p>
            <p class="text-sm text-muted">
              <b class="block text-xs uppercase tracking-wider text-amber-600 dark:text-amber-400">The bees</b>
              {r.bees}
            </p>
            <p class="mt-auto pt-3 border-t border-gray-200 dark:border-slate-700 text-sm text-muted">
              <b class="block text-xs uppercase tracking-wider text-primary dark:text-blue-300">TilePark</b>
              {r.tp}
            </p>
          </li>
        ))
      }
    </ol>
  </WidgetWrapper>

  <Features
    isDark
    tagline="Built for artificial intelligence"
    title="Swarm intelligence, made for machine learning."
    subtitle="Because TilePark works like a swarm, with many independent conveyors and countless possible routes, it is an ideal foundation for artificial intelligence. Every sequence the system runs is a lesson in which routes are fastest and which storage positions work best. The more it runs, the smarter it gets."
    columns={2}
    items={[
      {
        title: 'Learning from every garage',
        description:
          'Every garage contributes to this shared intelligence through anonymous usage patterns, such as typical arrival and departure times, never through personal tracking.',
        icon: 'tabler:brain',
      },
      {
        title: 'Already under way',
        description: 'TilePark has already begun implementing these learning capabilities.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <Features
    columns={3}
    items={[
      {
        title: 'The grid adapts to the site',
        description:
          '<strong>For architects.</strong> Without a fixed shuttle aisle or a central lift core dictating the layout, irregular plots, columns, and awkward corners are no longer a problem.',
        icon: 'tabler:ruler-2',
      },
      {
        title: 'No single point of failure',
        description:
          '<strong>For developers.</strong> A faulty conveyor never shuts down the garage. That protects uptime, tenant satisfaction, and the long-term value of the asset.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Conveyors everywhere, no aisles',
        description:
          '<strong>For everyone.</strong> Every position is a conveyor. With no ramps or driving lanes, almost the entire floor area is used for parking.',
        icon: 'tabler:layout-grid',
      },
    ]}
  />

  <!-- How it works ******************* -->
  <WidgetWrapper id="how-it-works" containerClass="max-w-7xl">
    <Fragment slot="bg"><Fragment set:html={blueBg} /></Fragment>
    <Headline
      tagline="How it works"
      title={`A garage that works like a ${em('sliding puzzle.')}`}
      subtitle="In a conventional garage, roughly half of the floor area is taken up by ramps and driving lanes. TilePark needs neither. Each car rests on a pallet, and the conveyors beneath move it lengthwise and crosswise, like the tiles of a sliding puzzle, until it reaches the transfer cabin."
    />
    <RealVideo />
    <GridDemo />
  </WidgetWrapper>

  <Steps
    title="From arrival to pickup"
    subtitle="Four steps, and the system does all the work in between."
    items={[
      {
        title: 'Effortless drop-off',
        description:
          'Drive into the friendly and safe transfer cabin, switch off the engine, and step out. From that moment on, the system takes over, and no one else drives your car.',
        icon: 'tabler:door-enter',
      },
      {
        title: 'Fully automated parking',
        description:
          'Your car stays on its own pallet throughout. The conveyors beneath move it precisely in X and Y to an available position, without anyone driving it.',
        icon: 'tabler:arrows-move',
      },
      {
        title: 'Secure, space-efficient storage',
        description:
          'Without ramps, driving lanes, or walkways, almost the entire floor area is available for parking. The storage area is not accessible to the public.',
        icon: 'tabler:lock',
      },
      {
        title: 'Ready when you are',
        description:
          'Request your car via app or terminal. The system calculates the best route, moves the surrounding cars aside, and presents your car in the transfer cabin.',
        icon: 'tabler:circle-check',
      },
    ]}
  />

  <!-- Third dimension ******************* -->
  <WidgetWrapper id="third-dimension" containerClass="max-w-7xl">
    <Headline
      tagline="The third dimension"
      title={`Add Z. ${em('Up to four cars on the footprint of one.')}`}
      subtitle="The XY grid moves cars across the floor. Add a TilePark stacker above selected conveyors, or above every conveyor, and the footprint of a single car holds up to four cars instead of one."
    />
    <StackerDemo />
  </WidgetWrapper>

  <Features
    columns={4}
    classes={{ container: 'max-w-7xl pt-0 md:pt-0 lg:pt-0' }}
    items={[
      {
        title: 'XY handles the logistics',
        description: 'The transport level brings each car beneath its stacker, using the same sliding-puzzle routing.',
        icon: 'tabler:arrows-move',
      },
      {
        title: 'The stacker lifts it up',
        description:
          'The stacker raises the car into a storage level directly above its conveyor. The storage levels need no conveyors, because cars are stacked as in a silo.',
        icon: 'tabler:arrow-bar-to-up',
      },
      {
        title: 'And brings it back down',
        description:
          'On request, the stacker lowers the car onto a free conveyor, which carries it to the transfer cabin.',
        icon: 'tabler:arrow-bar-to-down',
      },
      {
        title: 'Still no single point of failure',
        description:
          'Each stacker serves only its own conveyor. With no central lift tower that every car depends on, the rest of the garage keeps running.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <Features
    tagline="Why Z pays off"
    title="One automation level. Everything above is simple storage."
    subtitle="All of the automation is concentrated on the ground floor; only the transport level has conveyors. The levels above are stacked like a silo and need neither conveyors nor floor slabs. The building becomes simpler, lighter, and less expensive. <strong>It unlocks height.</strong> Whether in a basement, on a ground floor, or in a dedicated building, the clear height you already have becomes parking capacity."
    columns={3}
    defaultIcon="tabler:check"
    items={[
      {
        title: 'Conveyors on one level only',
        description:
          'Conveyors and drives are installed on the transport level alone. The storage levels are simple steel shelving, which means less equipment to purchase and maintain.',
      },
      {
        title: 'No slabs to build',
        description:
          'A stacked silo replaces intermediate parking decks, eliminating the cost of concrete slabs, formwork, and reinforcement.',
      },
      {
        title: 'No height lost to slabs',
        description:
          'Without slabs and their build-up, every meter of height is used for cars, so more levels fit within the same building.',
      },
      {
        title: 'Lower build-up height',
        description:
          'The XY conveyor level itself is very low, which saves floor height, pit depth and construction cost.',
      },
      {
        title: 'Lightweight construction',
        description:
          'The light steel structure means lower loads on the building, smaller foundations, and an easy fit in existing structures.',
      },
      {
        title: 'Less excavation',
        description:
          'A lower structure for the same number of cars means a shallower pit, reducing the cost of excavation, shoring, and waterproofing.',
      },
    ]}
  >
    <Fragment slot="bg"><Fragment set:html={blueBg} /></Fragment>
  </Features>

  <!-- The heart ******************* -->
  <Content
    id="heart"
    tagline="The heart of TilePark"
    title="No central control. No central point of failure."
    content="Just like bees in a hive, each TilePark conveyor has its own controller and acts independently. There is no master computer, shuttle, or lift that every car depends on. This decentralized control is the core of our technology and the source of the system’s speed and reliability."
    items={[
      {
        title: 'Conveyors move in parallel',
        description: 'Many conveyors move simultaneously, so no car has to wait for the one ahead of it.',
      },
      {
        title: 'A new route every time',
        description:
          'Each sequence is calculated for the grid’s current layout, so the system adapts rather than replaying a fixed program.',
      },
      {
        title: 'Robust by design',
        description:
          'A modular structure built from industry-standard components means fewer faults and fast replacement. Remote diagnostics let our team respond to any issue immediately.',
      },
      {
        title: 'A single fault never stops the garage',
        description:
          'If a conveyor goes offline, the others route around it, just like bees in a hive. <a class="underline" href="#how-it-works">Try it in the demo above.</a>',
      },
    ]}
    image={{
      src: '~/assets/images/tilepark/gastonia-drive-assembly.webp',
      alt: 'TilePark conveyor drives with geared motors and polyurethane wheels in assembly',
      aspect: '3/4',
    }}
  />

  <Features
    id="power-outage"
    isDark
    tagline="Power outage"
    title="And if the power goes out? Your car still comes out."
    subtitle="TilePark requires remarkably little power. With as little as 30 amps, the entire system can run on a generator, so drivers can still collect their cars during a power outage."
    columns={3}
    items={[
      {
        title: 'Low energy use',
        description:
          'On the XY level, cars only ever move horizontally, along the shortest optimized routes. Only the transport level is automated, and only the conveyors needed for a sequence move.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Multiple redundancy',
        description: 'Every conveyor has at least four drive motors, and every conveyor can take over for any other.',
        icon: 'tabler:engine',
      },
      {
        title: 'No single point of failure',
        description: 'If one conveyor is down, the others route around it.',
        icon: 'tabler:route',
      },
    ]}
  />

  <Features
    columns={2}
    items={[
      {
        title: 'Factory precision, tested before shipping',
        description:
          'Every system is pre-assembled in our own factories, and 100% of the conveyors pass a functional test before delivery. <a class="underline" href="#factories">Learn more about our factories below.</a>',
        icon: 'tabler:building-factory-2',
      },
      {
        title: 'Patented principle',
        description:
          'The TilePark XY sliding-puzzle principle is protected by European patent EP 3924576 B1, with further patents pending in the US and Germany.',
        icon: 'tabler:certificate',
      },
    ]}
  />

  <!-- EV charging ******************* -->
  <WidgetWrapper id="ev-charging" containerClass="max-w-7xl">
    <Fragment slot="bg"><Fragment set:html={blueBg} /></Fragment>
    <Headline
      tagline="Integrated EV charging"
      title={`Every space can charge. ${em('Every charger keeps working.')}`}
      subtitle="With fixed charging bays, a fully charged car blocks the charger until its driver returns. TilePark moves each EV to a charger, charges it to the level requested in the app, and then moves it away so the next vehicle can charge. Chargers never sit idle."
    />
    <EvDemo />

    <div class="mt-8 grid gap-4 md:grid-cols-[1.5fr_1fr_210px] items-start">
      <figure class="relative overflow-hidden rounded-lg shadow-lg bg-gray-500 h-80 md:h-[484px]">
        <Image
          src="~/assets/images/tilepark/ev-charging.webp"
          alt="Electric car charging on a TilePark pallet"
          layout="cover"
          widths={[480, 900]}
          sizes="(max-width: 767px) 100vw, 600px"
          width={900}
          height={744}
          class="w-full h-full object-cover"
        />
        <figcaption class="absolute left-3 right-3 bottom-3 rounded-md bg-slate-900/85 px-3 py-2 text-sm text-white">
          An EV charging on its pallet: the cable plugs into the socket built into the pallet.
        </figcaption>
      </figure>
      <figure class="relative overflow-hidden rounded-lg shadow-lg bg-black h-80 md:h-[484px]">
        <video
          src="/videos/ev-connection.mp4"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          class="w-full h-full object-cover"></video>
        <figcaption class="absolute left-3 right-3 bottom-3 rounded-md bg-slate-900/85 px-3 py-2 text-sm text-white">
          Connection to the charging point
        </figcaption>
      </figure>
      <figure class="mx-auto w-[220px] md:w-auto rounded-[26px] bg-slate-900 p-2 shadow-lg">
        <Image
          src="~/assets/images/tilepark/ev-app-screen.webp"
          alt="Charging session in the Parkstory app"
          width={460}
          height={995}
          widths={[230, 460]}
          sizes="220px"
          class="w-full h-auto rounded-[18px]"
        />
        <figcaption class="px-1 pt-2 pb-1 text-center text-xs text-slate-300">
          Real app screen: charging session with live kWh
        </figcaption>
      </figure>
    </div>
  </WidgetWrapper>

  <Features
    columns={4}
    items={[
      {
        title: 'Every pallet is EV-ready',
        description:
          'No dedicated charging bays and no wasted spaces. Park on the pallet, plug in your own cable at the Level 2 socket, and start charging from the app.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Fewer chargers, higher utilization',
        description:
          'Because chargers never sit blocked, a small number of charging points can serve every EV in the garage. Fewer chargers to buy, more revenue per charger.',
        icon: 'tabler:chart-arrows-vertical',
      },
      {
        title: 'Metered and billed in the app',
        description:
          'Live kWh, stop at any time, and pay in the same app that manages your arrival and pickup. Automated re-parking means no idle fees.',
        icon: 'tabler:receipt',
      },
      {
        title: 'Smart load management',
        description:
          'Charging power is managed intelligently across the whole system, and capacity can grow with demand without rebuilding the garage.',
        icon: 'tabler:adjustments-bolt',
      },
    ]}
    classes={{ container: 'max-w-7xl' }}
  />

  <Features
    columns={2}
    defaultIcon="tabler:check"
    classes={{ container: 'pt-0 md:pt-0 lg:pt-0' }}
    items={[
      {
        title: 'For the driver',
        description:
          'No waiting for a free charging station.<br>Automated re-parking after charging, so no idle fees.<br>One seamless journey, from arrival to pickup, in one app.',
      },
      {
        title: 'For the owner and operator',
        description:
          'Fewer dedicated charging points needed.<br>Expandable as demand grows.<br>Intelligent load management across the whole system.',
      },
    ]}
  />

  <!-- The app ******************* -->
  <WidgetWrapper id="app" containerClass="max-w-7xl">
    <Fragment slot="bg"><Fragment set:html={blueBg} /></Fragment>
    <AppShowcase />
  </WidgetWrapper>

  <Features
    tagline="For operators"
    title="Running a garage, made simple."
    subtitle="The same platform gives owners and operators everything they need to run TilePark day to day, from one dashboard."
    columns={4}
    classes={{ container: 'max-w-7xl' }}
    items={[
      {
        title: 'Billing',
        description: 'Subscriptions, short-term parking, EV charging and guest access, billed automatically.',
        icon: 'tabler:file-invoice',
      },
      {
        title: 'User management',
        description: 'Add, change and remove users, vehicles and access rights in a few clicks.',
        icon: 'tabler:users',
      },
      {
        title: 'Groups and roles',
        description:
          'Residents, employees, hotel guests or pool cars, each with their own rules, rates and time windows.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Live dashboard',
        description: 'Occupancy, charging, revenue and system status at a glance, with reports for every period.',
        icon: 'tabler:layout-dashboard',
      },
    ]}
  />

  <Features
    isDark
    tagline="Designed around the driver"
    title="Behind the machine, it is all about you."
    subtitle="Every part of TilePark exists to serve one moment: the moment you arrive and want your car. The app is where the system meets the people who use it, and it shapes everything around their needs, not the other way round."
    columns={3}
    classes={{ container: 'max-w-7xl' }}
    items={[
      {
        title: 'Your time, not the system’s',
        description:
          'Retrieval is planned around your schedule. Tell the app when you leave, or let it learn your routine, and your car is waiting instead of you.',
        icon: 'tabler:clock',
      },
      {
        title: 'No searching, no guessing',
        description:
          'No ramps, no levels, no hunting for a free space or for where you parked. You always know where your car is and when it will be ready.',
        icon: 'tabler:compass',
      },
      {
        title: 'Safe and stress-free',
        description:
          'No dark stairwells, no tight ramps and no walking through a garage at night. You only ever enter the friendly and safe transfer cabin, with your own car.',
        icon: 'tabler:shield-heart',
      },
      {
        title: 'Your circle, your rules',
        description:
          'Family, guests, a valet or a colleague: you decide who may use the garage, when, and with which car, and you can change it at any time.',
        icon: 'tabler:users',
      },
      {
        title: 'Always informed',
        description:
          'Notifications tell you when your car is ready, when charging is complete and when a booking is about to end, so nothing comes as a surprise.',
        icon: 'tabler:bell',
      },
      {
        title: 'One app, one journey',
        description:
          'Access, parking, charging, guests and payment in one place, with no tickets, no cards and no second app. It feels like having your own valet.',
        icon: 'tabler:sparkles',
      },
    ]}
  />

  <!-- Future-proof ******************* -->
  <WidgetWrapper id="future-proof" containerClass="max-w-7xl">
    <Headline
      tagline="Decide for tomorrow"
      title={`Don’t miss the bus. ${em('Choose the system that keeps getting better.')}`}
      subtitle="Real estate takes time. Years pass between the first sketch and the day the first residents move in, and the building then serves for decades. A parking technology chosen today is already years old on opening day, and the gap only widens from there. TilePark moves the other way."
      classes={{ container: 'max-w-4xl' }}
    />
    <FutureTimeline />
  </WidgetWrapper>

  <Features
    columns={4}
    classes={{ container: 'max-w-7xl pt-0 md:pt-0 lg:pt-0' }}
    items={[
      {
        title: 'The most advanced system on the market',
        description:
