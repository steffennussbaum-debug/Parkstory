---
/**
 * Concept D — Engineering Heritage, in the Parkstory corporate identity.
 *
 * Light and editorial, like a company chronicle: warm paper, deep green-black
 * ink, Outfit and Inter, lime only as a marker. It leads with decades of
 * know-how (two lines of engineering that meet in TilePark), then shows the
 * product, the factories, quality and service as the proof.
 */
import { Image } from 'astro:assets';
import ConceptLayout from '~/layouts/ConceptLayout.astro';
import ParkstoryMark from '~/components/concepts/ParkstoryMark.astro';
import TileField from '~/components/concepts/TileField.astro';
import GridDemo from '~/components/tilepark/GridDemo.astro';
import { shift, breakthrough, valueChain, quality, delivery, decision, dna, trust } from '~/data/concepts';

import kehlPlant from '~/assets/images/tilepark/kehl-plant.webp';
import gastPlant from '~/assets/images/tilepark/gastonia-plant.webp';
import wheels from '~/assets/images/tilepark/gastonia-wheels.webp';
import welding from '~/assets/images/tilepark/kehl-welding.webp';
import drives from '~/assets/images/tilepark/gastonia-drive-assembly.webp';
import steel from '~/assets/images/tilepark/kehl-steel.webp';

import '@fontsource-variable/inter';
import '@fontsource-variable/outfit';
import '~/assets/styles/tilepark.css';
import '~/assets/styles/concept-demos.css';

const nav = [
  ['Heritage', '#heritage'],
  ['TilePark', '#tilepark'],
  ['Factories', '#factories'],
  ['Quality', '#quality'],
  ['Service', '#service'],
  ['People', '#people'],
];
const lessonPics = [
  [wheels, 'Drive wheel units, Gastonia', '50% 50%'],
  [welding, 'Robotic welding, Kehl', '50% 35%'],
  [drives, 'Conveyor drive assembly, Gastonia', '50% 55%'],
  [steel, 'Galvanised steel, Kehl', '50% 50%'],
] as const;
const plantPics = [
  [kehlPlant, '50% 55%'],
  [gastPlant, '55% 60%'],
] as const;
---

<ConceptLayout
  title="Parkstory — Concept D · Engineering Heritage"
  description={shift.lead}
  bodyClass="cd"
  current="engineering-heritage"
  switcherTheme="light"
>
  <header class="cd-nav">
    <div class="cd-nav-in">
      <a href="#top" class="cd-logo" aria-label="Parkstory, back to top"><ParkstoryMark /></a>
      <nav aria-label="Sections" class="cd-links">
        {nav.map(([t, h]) => <a href={h}>{t}</a>)}
      </nav>
      <a href="#decision" class="cd-nav-cta">Technology briefing</a>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="cd-hero">
      <div class="cd-wrap cd-hero-in">
        <div>
          <p class="cd-kicker" data-reveal>Parkstory · Automated parking since the early 1990s</p>
          <h1 data-reveal>Decades of engineering. <em>A new architecture for parking.</em></h1>
          <p class="cd-lead" data-reveal>
            Parkstory brings more than 75 years of industrial engineering and over 30 years of software development to
            automated parking. TilePark is what that know-how builds next.
          </p>
          <div class="cd-ctas" data-reveal>
            <a class="cd-btn" href={decision.ctaHref}>{decision.cta}<span aria-hidden="true">→</span></a>
            <a class="cd-btn cd-btn--line" href="#heritage">Read our story</a>
          </div>
        </div>
        <figure class="cd-hero-pic" data-reveal>
          <Image
            src={kehlPlant}
            alt="Parkstory Manufacturing plant in Kehl, Germany"
            widths={[600, 1000]}
            sizes="(max-width: 960px) 100vw, 45vw"
            loading="eager"
          />
          <figcaption>Parkstory Manufacturing, Kehl, Germany</figcaption>
        </figure>
      </div>
    </section>

    <!-- LEDGER -->
    <section class="cd-ledger" aria-label="Parkstory in figures">
      <div class="cd-wrap">
        <ul>
          {
            trust.facts.map((f, i) => (
              <li data-reveal style={`--reveal-delay:${0.06 * i}s`}>
                <p class="cd-ledger-n">
                  {f.unit === 'since the early' && <span>since the early</span>}
                  {f.n}
                  {f.unit !== 'since the early' && <span>{f.unit}</span>}
                </p>
                <h2>{f.k}</h2>
                <p>{f.v}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- HERITAGE: two lines of know-how meet in TilePark -->
    <section class="cd-sec" id="heritage">
      <div class="cd-wrap">
        <p class="cd-label" data-reveal>01 — {dna.eyebrow}</p>
        <div class="cd-split">
          <h2 class="cd-h2" data-reveal>{dna.title} <em>{dna.titleAccent}</em></h2>
          <p class="cd-body" data-reveal>{dna.mergeBody}</p>
        </div>

        <div class="cd-rails">
          {
            dna.legacies.map((l, i) => (
              <div class="cd-rail" data-reveal style={`--reveal-delay:${0.1 * i}s`}>
                <div class="cd-rail-head">
                  <p class="cd-rail-n">{l.years}</p>
                  <div>
                    <h3>{l.name}</h3>
                    <p>{l.text}</p>
                  </div>
                </div>
                <ol>
                  {l.steps.map(([k, v]) => (
                    <li>
                      <b>{k}</b>
                      {v && <span>{v}</span>}
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }
          <div class="cd-meet" data-reveal>
            <span class="cd-meet-dot" aria-hidden="true"></span>
            <p>
              <b>TilePark</b>
              {dna.merge}
            </p>
          </div>
        </div>

        <div class="cd-founders" data-reveal>
          <p>{dna.foundersBody}</p>
          <ul>
            {
              dna.founders.map((f) => (
                <li>
                  <b>{f.name}</b>
                  <span>{f.role}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- LESSONS -->
    <section class="cd-sec cd-sec--tint">
      <div class="cd-wrap">
        <p class="cd-label" data-reveal>02 — What decades taught us</p>
        <h2 class="cd-h2" data-reveal>Experience you can see <em>in every TilePark.</em></h2>
        <ol class="cd-lessons">
          {
            trust.lessons.map((l, i) => (
              <li data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                <figure>
                  <Image
                    src={lessonPics[i][0]}
                    alt={lessonPics[i][1]}
                    widths={[400, 700]}
                    sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 25vw"
                    style={`object-position:${lessonPics[i][2]}`}
                  />
                  <figcaption>{lessonPics[i][1]}</figcaption>
                </figure>
                <span class="cd-n">0{i + 1}</span>
                <h3>{l.k}</h3>
                <p>{l.v}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- TILEPARK -->
    <section class="cd-sec" id="tilepark">
      <div class="cd-wrap">
        <p class="cd-label" data-reveal>03 — Built on that know-how</p>
        <div class="cd-split">
          <h2 class="cd-h2" data-reveal>{breakthrough.title.split('. ')[0]}. <em>A different architecture.</em></h2>
          <p class="cd-body" data-reveal>{breakthrough.body}</p>
        </div>
        <ol class="cd-principles">
          {
            breakthrough.principles.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                <span class="cd-n">{p.n}</span>
                <h3>{p.k}</h3>
                <p>{p.v}</p>
              </li>
            ))
          }
        </ol>
        <div class="cx-demos cd-demo" data-reveal><GridDemo /></div>
        <p class="cd-note">{breakthrough.patent}</p>
      </div>
    </section>

    <!-- FACTORIES -->
    <section class="cd-sec cd-sec--tint" id="factories">
      <div class="cd-wrap">
        <p class="cd-label" data-reveal>04 — {valueChain.eyebrow}</p>
        <div class="cd-split">
          <h2 class="cd-h2" data-reveal>{dna.ownership.title} <em>{dna.ownership.titleAccent}</em></h2>
          <p class="cd-body" data-reveal>{valueChain.body}</p>
        </div>
        <ol class="cd-line" data-reveal>
          {
            valueChain.steps.map((st) => (
              <li>
                <b>{st.k}</b>
                <span>{st.v}</span>
              </li>
            ))
          }
        </ol>
        <div class="cd-plants">
          {
            valueChain.plants.map((pl, i) => (
              <article class="cd-plant" data-reveal style={`--reveal-delay:${0.1 * i}s`}>
                <figure>
                  <Image
                    src={plantPics[i][0]}
                    alt={`Parkstory plant in ${pl.name}`}
                    widths={[600, 1000]}
                    sizes="(max-width: 960px) 100vw, 50vw"
                    style={`object-position:${plantPics[i][1]}`}
                  />
                </figure>
                <div class="cd-plant-txt">
                  <p class="cd-flag">{pl.flag}</p>
                  <h3>{pl.name}</h3>
                  <p>{pl.text}</p>
                  <ul>
                    {pl.caps.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- QUALITY (dark band) -->
    <section class="cd-dark" id="quality">
      <div class="cd-wrap cd-quality">
        <div>
          <p class="cd-label cd-label--dark" data-reveal>05 — {quality.eyebrow}</p>
          <blockquote class="cd-quote" data-reveal>
            <p>{dna.quality}</p>
          </blockquote>
          <p class="cd-body cd-body--dark" data-reveal>{quality.body}</p>
          <ul class="cd-checks">
            {
              quality.checks.map((c) => (
                <li data-reveal>
                  <b>{c.k}</b> {c.v}
                </li>
              ))
            }
          </ul>
        </div>
        <figure class="cd-video" data-reveal>
          <video
            src="/videos/load-test.mp4"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="A conveyor segment running on the load test rig"></video>
          <figcaption>{quality.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- SERVICE -->
    <section class="cd-sec" id="service">
      <div class="cd-wrap">
        <p class="cd-label" data-reveal>06 — {delivery.eyebrow}</p>
        <div class="cd-uptime" data-reveal>
          <p class="cd-uptime-n">{delivery.uptime.value}<span>{delivery.uptime.label}</span></p>
          <div>
            <h2 class="cd-h2">{delivery.uptime.claim}</h2>
            <p class="cd-body">{delivery.uptime.note}</p>
          </div>
        </div>
        <ol class="cd-phases">
          {
            delivery.phases.map((ph, i) => (
              <li data-reveal style={`--reveal-delay:${0.06 * i}s`}>
                <span class="cd-n">{i + 1}</span>
                <h3>{ph.k}</h3>
                <p>{ph.v}</p>
              </li>
            ))
          }
        </ol>
        <ul class="cd-service">
          {
            delivery.service.steps.map((st) => (
              <li data-reveal>
                <b>{st.k}</b>
                <p>{st.v}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- PEOPLE -->
    <section class="cd-sec cd-sec--tint" id="people">
      <div class="cd-wrap">
        <p class="cd-label" data-reveal>07 — People</p>
        <div class="cd-split">
          <h2 class="cd-h2" data-reveal>{dna.peopleTitle} <em>{dna.peopleAccent}</em></h2>
          <p class="cd-body" data-reveal>{dna.peopleBody}</p>
        </div>
        <ul class="cd-sites">
          {
            dna.sites.map((st) => (
              <li data-reveal>
                <span class="cd-flag">{st.flag}</span>
                <b>{st.country}</b>
                <span>{st.place}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- DECISION -->
    <section class="cd-decision" id="decision">
      <div class="cd-decision-field" aria-hidden="true">
        <TileField cell={40} density={0.86} rate={4} accentShare={0.1} />
      </div>
      <div class="cd-wrap cd-decision-in">
        <h2 data-reveal>{decision.title}</h2>
        <p class="cd-body cd-body--dark" data-reveal>{decision.body}</p>
        <div class="cd-ctas" data-reveal>
          <a class="cd-btn cd-btn--lime" href={decision.ctaHref}>{decision.cta}<span aria-hidden="true">→</span></a>
          <a class="cd-btn cd-btn--dark" href={decision.secondaryHref} target="_blank" rel="noopener"
            >{decision.secondary}</a
          >
        </div>
        <p class="cd-sign" data-reveal>{dna.sign}</p>
      </div>
    </section>
  </main>

  <footer class="cd-foot">
    <div class="cd-wrap">
      <ParkstoryMark />
      <p>Designed, programmed and built by Parkstory in Kehl, Germany, and Gastonia, USA.</p>
      <p>TilePark · European patent EP 3924576 B1</p>
    </div>
  </footer>
</ConceptLayout>

<style is:global>
  html:root {
    --paper: #f2f0e9;
    --paper-2: #e8e5db;
    --ink: #0b1a13;
    --mid: #4e5f57;
    --rule: rgb(11 26 19 / 14%);
    --green: #3f6b1a;
    --lime: #b8f03c;
    --dark: #040d09;
    --display: 'Outfit Variable', 'Outfit', Arial, sans-serif;
    --text: 'Inter Variable', 'Inter', 'Helvetica Neue', Arial, sans-serif;
    /* demo theme: dark CI panel on the light page */
    --tp-accent: #b8f03c;
    --tp-accent-soft: #b8f03c;
    --tp-accent-wash: rgb(184 240 60 / 15%);
    --tp-panel: #07150f;
    --tp-panel-2: #0f261b;
    --tp-board: #040d09;
    --tp-line: rgb(255 255 255 / 8%);
    --tp-line-2: rgb(255 255 255 / 18%);
    --tp-text-dim: #a2beb0;
    --tp-text-soft: #c5d9cf;
    --tp-warn: #f5a524;
    --cx-radius: 6px;
    --cx-radius-sm: 4px;
    --cx-btn-radius: 3px;
    --cx-btn-bg: #b8f03c;
    --cx-btn-fg: #07150f;
    --cx-font: var(--text);
    --cx-font-display: var(--display);
    --cx-font-mono: var(--text);
    --cx-tile: #1f3a2c;
  }
  .cd {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--text);
    font-size: 17px;
    line-height: 1.6;
  }
  .cd *,
  .cd *::before,
  .cd *::after {
    box-sizing: border-box;
  }
  /* reset with zero specificity, so every component class can set its own spacing */
  :where(.cd) :where(h1, h2, h3, p, ol, ul, figure, blockquote) {
    margin: 0;
  }
  :where(.cd) :where(ol, ul) {
    list-style: none;
    padding: 0;
  }
  :where(.cd) img {
    display: block;
    max-width: 100%;
  }
  .cd em {
    font-style: normal;
    color: var(--green);
  }
  .cd-wrap {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 56px);
  }

  /* nav: the CI logo on a dark bar */
  .cd-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--dark);
    color: #fff;
  }
  .cd-nav-in {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 56px);
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .cd-logo {
    font-size: 26px;
    text-decoration: none;
    margin-right: auto;
  }
  .cd-links {
    display: flex;
    gap: 1.6rem;
    font-size: 0.88rem;
  }
  .cd-links a {
    color: #c5d9cf;
    text-decoration: none;
    white-space: nowrap;
  }
  .cd-links a:hover {
    color: #fff;
  }
  .cd-nav-cta {
    color: #fff;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    border: 1px solid var(--lime);
    border-radius: 3px;
    padding: 0.5rem 0.9rem;
    white-space: nowrap;
  }

  /* type */
  .cd h1,
  .cd-h2,
  .cd h3,
  .cd-quote p,
  .cd-decision h2 {
    font-family: var(--display);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .cd h1 {
    font-size: clamp(2.5rem, 4.6vw, 4.8rem);
    line-height: 1.02;
    max-width: 15ch;
    margin-top: 1.25rem;
  }
  .cd h1 em {
    display: block;
  }
  .cd-h2 {
    font-size: clamp(2rem, 3.6vw, 3.6rem);
    line-height: 1.06;
    max-width: 22ch;
  }
  .cd-kicker,
  .cd-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mid);
  }
  .cd-label {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.5rem;
  }
  .cd-label::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 1px var(--ink);
  }
  .cd-label--dark {
    color: #a2beb0;
  }
  .cd-label--dark::before {
    box-shadow: none;
  }
  .cd-lead {
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    color: var(--mid);
    max-width: 46ch;
    margin-top: 1.75rem;
  }
  .cd-body {
    font-size: clamp(1.02rem, 1.2vw, 1.15rem);
    color: var(--mid);
    max-width: 54ch;
  }
  .cd-body--dark {
    color: #c5d9cf;
  }
  .cd-note {
    margin-top: 1.25rem;
    font-size: 0.82rem;
    color: var(--mid);
  }
  .cd-n {
    font-family: var(--display);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }
  .cd-split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(28px, 5vw, 96px);
    align-items: end;
  }

  /* buttons */
  .cd-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .cd-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0 1.3rem;
    border-radius: 3px;
    background: var(--ink);
    color: #fff;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s;
  }
  .cd-btn:hover {
    background: #1d3326;
  }
  .cd-btn--line {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--ink);
  }
  .cd-btn--line:hover {
    background: var(--paper-2);
  }
  .cd-btn--lime {
    background: var(--lime);
    color: var(--dark);
  }
  .cd-btn--lime:hover {
    background: #c9f765;
  }
  .cd-btn--dark {
    background: transparent;
    color: #fff;
    border: 1px solid rgb(255 255 255 / 35%);
  }

  /* sections */
  .cd-sec {
    padding: clamp(80px, 10vw, 152px) 0;
  }
  .cd-sec--tint {
    background: var(--paper-2);
  }

  /* hero */
  .cd-hero {
    padding: clamp(56px, 8vw, 120px) 0 clamp(48px, 6vw, 88px);
  }
  .cd-hero-in {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }
  .cd-hero-pic {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 4px;
  }
  .cd-hero-pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }
  .cd-hero-pic figcaption,
  .cd-lessons figcaption,
  .cd-video figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    font-size: 0.72rem;
    font-weight: 500;
    color: #fff;
    background: rgb(4 13 9 / 80%);
    padding: 0.3rem 0.6rem;
    border-radius: 2px;
  }

  /* ledger */
  .cd-ledger {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .cd-ledger ul {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  .cd-ledger li {
    padding: 2rem 1.25rem 2.25rem;
    border-left: 1px solid var(--rule);
  }
  .cd-ledger li:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .cd-ledger-n {
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(2.2rem, 3.2vw, 3.2rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .cd-ledger-n span {
    display: block;
    font-family: var(--text);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green);
    margin: 0.5rem 0 0;
  }
  .cd-ledger-n span:first-child {
    margin: 0 0 0.5rem;
  }
  .cd-ledger h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.02rem;
    margin-top: 1rem;
  }
  .cd-ledger li > p:last-child {
    font-size: 0.86rem;
    color: var(--mid);
    margin-top: 0.3rem;
  }

  /* heritage rails */
  .cd-rails {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(20px, 3vw, 40px);
    margin-top: clamp(48px, 6vw, 88px);
  }
  .cd-rail {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .cd-rail-head {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }
  .cd-rail-n {
    font-family: var(--display);
