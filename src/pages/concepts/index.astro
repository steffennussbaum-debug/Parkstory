---
/**
 * Overview of the three homepage design concepts, shown side by side as live,
 * scaled-down previews. Draft page: not linked from the site, marked noindex.
 */
import ConceptLayout from '~/layouts/ConceptLayout.astro';
import { concepts } from '~/data/concepts';
import '@fontsource-variable/inter-tight';

const swatches: Record<string, { colors: string[]; type: string }> = {
  'architectural-future': { colors: ['#f3f1ec', '#121212', '#a8442b', '#e9e5dc'], type: 'Inter Tight · Newsreader' },
  'technological-disruption': {
    colors: ['#040d09', '#ffffff', '#b8f03c', '#5ee3a1'],
    type: 'Outfit · Inter (Parkstory CI)',
  },
  'industrial-intelligence': {
    colors: ['#141618', '#e9e8e4', '#ff5b1f', '#8d9297'],
    type: 'IBM Plex Sans · Plex Mono',
  },
  'engineering-heritage': {
    colors: ['#f2f0e9', '#0b1a13', '#b8f03c', '#3f6b1a'],
    type: 'Outfit · Inter (Parkstory CI, light)',
  },
  'built-by-parkstory': {
    colors: ['#0a0f0c', '#ffffff', '#b8f03c', '#f5a524'],
    type: 'Outfit · Inter (Parkstory CI)',
  },
  'proven-disruption': {
    colors: ['#040d09', '#ffffff', '#b8f03c', '#5ee3a1'],
    type: 'Outfit · Inter (Parkstory CI)',
  },
};
const rounds = [
  {
    title: 'First round',
    text: 'Three visual languages for the same story.',
    items: concepts.filter((c) => 'ABC'.includes(c.letter)),
  },
  {
    title: 'New: confidence in decades of know-how',
    text: 'Three alternatives that lead with Parkstory’s engineering heritage, its own factories and its service, then introduce TilePark as the new architecture built on that know-how.',
    items: concepts.filter((c) => 'DEF'.includes(c.letter)),
  },
];
---

<ConceptLayout title="Parkstory — Homepage concepts" bodyClass="cx-index">
  <header class="ix-head">
    <p class="ix-kicker">Parkstory · Homepage redesign · Draft</p>
    <h1>Directions for the new Parkstory homepage</h1>
    <p class="ix-sub">
      Every concept tells Parkstory’s story with the same facts; only the emphasis and the visual language differ. The
      current website is unchanged until a direction is chosen.
    </p>
  </header>

  {
    rounds.map((r) => (
      <section class="ix-round">
        <div class="ix-round-head">
          <h2>{r.title}</h2>
          <p>{r.text}</p>
        </div>
        <div class="ix-grid">
          {r.items.map((c) => (
            <article class="ix-card">
              <a class="ix-frame" href={`/concepts/${c.slug}`} aria-label={`Open concept ${c.letter}: ${c.name}`}>
                <iframe
                  src={`/concepts/${c.slug}`}
                  title={`Preview of concept ${c.letter}`}
                  loading="lazy"
                  tabindex="-1"
                  scrolling="no"
                />
              </a>
              <div class="ix-meta">
                <p class="ix-letter">Concept {c.letter}</p>
                <h2>{c.name}</h2>
                <p>{c.summary}</p>
                <div class="ix-sw">
                  {swatches[c.slug].colors.map((col) => (
                    <i style={`background:${col}`} />
                  ))}
                  <span>{swatches[c.slug].type}</span>
                </div>
                <a class="ix-open" href={`/concepts/${c.slug}`}>
                  Open full page →
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <footer class="ix-foot">
    <p>
      Notes: all facts and figures come from Parkstory’s existing material. The economics figures are a worked example
      from the TilePark planning model, with their assumptions shown on each page. Photography is Parkstory’s own;
      architectural project photography would strengthen every concept. <a href="/">Back to the current site</a>
    </p>
  </footer>

  <script>
    // Scale each 1440px-wide live preview to fit its card.
    const frames = document.querySelectorAll<HTMLElement>('.ix-frame');
    const ro = new ResizeObserver((entries) => {
      for (const e of entries) (e.target as HTMLElement).style.setProperty('--s', String(e.contentRect.width / 1440));
    });
    frames.forEach((f) => ro.observe(f));
  </script>
</ConceptLayout>

<style is:global>
  .cx-index {
    background: #ecebe8;
    color: #141414;
    font-family: 'Inter Tight Variable', 'Helvetica Neue', Arial, sans-serif;
  }
  .ix-head {
    max-width: 1600px;
    margin: 0 auto;
    padding: 72px clamp(20px, 3vw, 48px) 40px;
  }
  .ix-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6862;
  }
  .ix-head h1 {
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin-top: 1rem;
    max-width: 22ch;
  }
  .ix-sub {
    margin-top: 1.25rem;
    max-width: 70ch;
    color: #45433f;
    line-height: 1.55;
  }
  .ix-round + .ix-round {
    margin-top: 72px;
  }
  .ix-round-head {
    max-width: 1600px;
    margin: 0 auto 24px;
    padding: 24px clamp(20px, 3vw, 48px) 0;
    border-top: 1px solid rgb(18 18 18 / 14%);
  }
  .ix-round-head h2 {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .ix-round-head p {
    margin-top: 6px;
    color: #6b6862;
    max-width: 72ch;
  }
  .ix-grid {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 clamp(20px, 3vw, 48px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2vw, 32px);
  }
  .ix-card {
    background: #fff;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 0 rgb(0 0 0 / 6%);
  }
  .ix-frame {
    --w: 1440;
    position: relative;
    display: block;
    aspect-ratio: 1440 / 1700;
    overflow: hidden;
    background: #ddd;
  }
  .ix-frame iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1440px;
    height: 1700px;
    border: 0;
    pointer-events: none;
    transform-origin: 0 0;
    transform: scale(var(--s, 0.3));
  }
  .ix-frame:hover {
    outline: 2px solid #141414;
    outline-offset: -2px;
  }
  .ix-meta {
    padding: 1.5rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .ix-letter {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b6862;
  }
  .ix-meta h2 {
    font-weight: 500;
    font-size: 1.6rem;
    letter-spacing: -0.025em;
  }
  .ix-meta p {
    color: #45433f;
    line-height: 1.5;
  }
  .ix-sw {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: #6b6862;
  }
  .ix-sw i {
    width: 22px;
    height: 22px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 12%);
  }
  .ix-sw span {
    margin-left: 0.5rem;
  }
  .ix-open {
    margin-top: auto;
    padding-top: 1rem;
    font-weight: 500;
    text-decoration: none;
  }
  .ix-open:hover {
    text-decoration: underline;
  }
  .ix-foot {
    max-width: 1600px;
    margin: 0 auto;
    padding: 40px clamp(20px, 3vw, 48px) 96px;
    font-size: 0.85rem;
    color: #6b6862;
  }
  .ix-foot p {
    max-width: 90ch;
    line-height: 1.55;
  }
  @media (max-width: 1000px) {
    .ix-grid {
      grid-template-columns: 1fr;
      max-width: 640px;
    }
  }
</style>
