    background: rgb(4 13 9 / 90%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .cb-nav.show-mark .cb-mark,
  .cb-nav.show-mark .cb-chapters {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .cb-chapters {
    display: flex;
    gap: 1.6rem;
  }
  .cb-chapters a {
    text-decoration: none;
    color: var(--soft);
    white-space: nowrap;
  }
  .cb-chapters a:hover {
    color: var(--white);
  }
  .cb-chapters i {
    font-style: normal;
    color: var(--grey);
    font-size: 0.72rem;
    margin-right: 0.35rem;
  }
  .cb-nav-cta {
    text-decoration: none;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    padding: 0.55rem 0.95rem;
    font-weight: 500;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .cb-nav-cta:hover {
    border-color: var(--lime);
    color: var(--lime);
  }
  @media (max-width: 1180px) {
    .cb-chapters {
      display: none;
    }
  }

  /* --- hero --- */
  .cb-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .cb-field {
    position: absolute;
    inset: 0;
    perspective: 1100px;
    perspective-origin: 50% 0%;
  }
  .cb-field-plane {
    position: absolute;
    left: -30%;
    right: -30%;
    top: 22%;
    height: 140%;
    transform: rotateX(60deg);
    transform-origin: 50% 0%;
    --tf-bg: #040d09;
    --tf-line: rgb(255 255 255 / 7%);
    --tf-car: #24443a;
    --tf-car-2: #173025;
    --tf-glass: rgb(0 0 0 / 55%);
    --tf-accent: #b8f03c;
  }
  .cb-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #040d09 0%, rgb(4 13 9 / 70%) 30%, rgb(4 13 9 / 20%) 58%, rgb(4 13 9 / 92%) 100%),
      radial-gradient(80% 60% at 50% 70%, transparent, rgb(4 13 9 / 55%));
  }
  .cb-hero-in {
    position: relative;
    width: 100%;
    padding-top: 110px;
    padding-bottom: clamp(36px, 7vh, 72px);
  }
  .cb-word {
    font-size: clamp(3.4rem, min(10vw, 16vh), 10rem);
    margin-bottom: clamp(1.75rem, 5vh, 3.5rem);
  }
  .cb-hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(32px, 5vw, 96px);
    align-items: end;
  }
  .cb-lead {
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.5;
    color: var(--soft);
    max-width: 34ch;
  }
  .cb-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .cb-scroll i {
    width: 1px;
    height: 40px;
    background: linear-gradient(var(--lime), transparent);
    animation: cbDrop 2.2s ease-in-out infinite;
  }
  @keyframes cbDrop {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  .cb-rise {
    animation: cbRise 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes cbRise {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
  }

  /* --- question --- */
  .cb-points {
    border-top: 0;
  }
  .cb-question {
    height: 170vh;
    position: relative;
    border-top: 1px solid var(--line);
  }
  .cb-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
  }
  .cb-q {
    font-size: clamp(2.4rem, 5.6vw, 6.4rem);
    line-height: 1.03;
    margin-top: 1.75rem;
    max-width: 18ch;
  }
  .cb-q span {
    color: #1d3328;
    transition: color 0.35s;
  }
  .cb-q span.lit {
    color: var(--white);
  }
  .cb-q span.lit:nth-last-child(-n + 2) {
    color: var(--lime);
  }
  .cb-asklabel {
    margin-top: clamp(48px, 6vw, 88px);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .cb-ask {
    margin-top: 1rem;
  }
  .cb-ask li {
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 1.5rem;
    padding: 1.6rem 0;
    align-items: start;
  }
  .cb-ask h3 {
    font-size: clamp(1.25rem, 1.8vw, 1.6rem) !important;
    line-height: 1.2;
  }
  .cb-ask p {
    padding-top: 0.2rem;
  }
  .cb-tight .cb-split {
    align-items: start;
  }
  .cb-timeline {
    margin-top: clamp(96px, 12vw, 160px);
    --dt-ink: #fff;
    --dt-muted: #a2beb0;
    --dt-line: rgb(255 255 255 / 14%);
    --dt-old: #4d6a5c;
    --dt-accent: #b8f03c;
  }
  .cb-timeline .cb-kicker {
    margin-bottom: 2.5rem;
  }

  /* --- cinema --- */
  .cb-cinema {
    position: relative;
    height: 82svh;
    min-height: 560px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .cb-cinema video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1) brightness(0.62);
  }
  .cb-cinema--ev video {
    filter: grayscale(0.4) contrast(1.08) brightness(0.62);
  }
  .cb-cinema-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #040d09 0%, transparent 28%, rgb(4 13 9 / 40%) 55%, #040d09 100%),
      linear-gradient(90deg, rgb(4 13 9 / 55%), transparent 60%);
  }
  .cb-cinema-in {
    position: relative;
    width: 100%;
    padding-bottom: clamp(48px, 8vh, 96px);
  }
  .cb-tag {
    margin-top: 2rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .cb-four + .cx-demos {
    margin-top: 0;
  }

  /* --- nature --- */
  .cb-nature {
    margin-top: clamp(96px, 12vw, 176px);
    padding-top: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--line);
  }
  .cb-nature .cx-demos {
    margin-top: clamp(40px, 5vw, 72px);
  }
  .cb-rules {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: clamp(40px, 5vw, 72px);
    border-top: 1px solid var(--line-2);
  }
  .cb-rules li {
    padding: 1.4rem 1.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .cb-rules li + li {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }
  .cb-rule-q {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .cb-rule-b,
  .cb-rule-t {
    font-size: 0.86rem;
    color: var(--soft);
  }
  .cb-rule-b b,
  .cb-rule-t b {
    display: block;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.2rem;
  }
  .cb-rule-b b {
    color: var(--amber);
  }
  .cb-rule-t {
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  .cb-rule-t b {
    color: var(--lime);
  }

  /* --- 04 why TilePark leads --- */
  .cb-edge {
    overflow: hidden;
    background: var(--ink-2);
  }
  .cb-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(184 240 60 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(184 240 60 / 5%) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(180deg, transparent, #000 20%, #000 70%, transparent);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 20%, #000 70%, transparent);
    pointer-events: none;
  }
  .cb-edge .cb-wrap {
    position: relative;
  }
  .cb-pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: clamp(56px, 7vw, 104px);
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cb-pillars li {
    background: var(--ink-2);
    padding: 2rem 1.75rem 2.25rem;
    transition: background 0.3s;
  }
  .cb-pillars li:hover {
    background: var(--lift);
  }
  .cb-pillar-n {
    display: block;
    font-family: var(--display);
    font-weight: 300;
    font-size: 3.2rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--lime);
  }
  .cb-pillars h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    margin-top: 2.5rem !important;
  }
  .cb-pillars p {
    margin-top: 0.6rem;
    color: var(--soft);
    font-size: 0.95rem;
  }
  .cb-stack {
    display: grid;
    grid-template-columns: 1fr 0.55fr;
    grid-template-rows: auto auto auto;
    column-gap: clamp(24px, 3vw, 48px);
    margin-top: clamp(72px, 9vw, 136px);
  }
  .cb-layer {
    grid-column: 1;
    padding: 1.75rem 2rem;
    border: 1px solid var(--line-2);
  }
  .cb-layer--soft {
    border-color: rgb(184 240 60 / 45%);
    background: rgb(184 240 60 / 4%);
  }
  .cb-layer-h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    margin-bottom: 1.1rem;
  }
  .cb-layer-h span {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .cb-layer--soft .cb-layer-h span {
    color: var(--lime);
  }
  .cb-layer-h em {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--grey);
  }
  .cb-layer ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem 2rem;
  }
  .cb-layer li {
    position: relative;
    padding-left: 1.2rem;
    font-size: 0.95rem;
    color: var(--soft);
  }
  .cb-layer li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    background: currentColor;
    opacity: 0.6;
  }
  .cb-layer--soft li::before {
    background: var(--lime);
    opacity: 1;
    border-radius: 50%;
  }
  .cb-layer-join {
    grid-column: 1;
    display: flex;
    justify-content: space-around;
    height: 44px;
    padding: 0 2rem;
  }
  .cb-layer-join i {
    width: 1px;
    background: linear-gradient(rgb(184 240 60 / 60%), var(--line-2));
  }
  .cb-stack-img {
    grid-column: 2;
    grid-row: 1 / span 3;
    margin: 0;
    position: relative;
  }
  .cb-stack-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.6) contrast(1.05);
  }
  .cb-stack-img figcaption {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-size: 0.72rem;
    background: rgb(4 13 9 / 85%);
    padding: 0.3rem 0.6rem;
  }

  /* --- economics --- */
  .cb-big {
    margin: clamp(56px, 7vw, 104px) 0 0;
  }
  .cb-big-cap {
    font-size: 0.85rem;
    color: var(--grey);
    margin-bottom: 1.25rem;
  }
  .cb-big-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-2);
    border-bottom: 1px solid var(--line);
  }
  .cb-big-cell {
    padding: 2rem 2rem 2rem 0;
  }
  .cb-big-cell + .cb-big-cell {
    padding-left: 2rem;
    border-left: 1px solid var(--line);
  }
  .cb-big-cell b {
    display: block;
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(4.5rem, 10vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: #3d5a4b;
    font-variant-numeric: tabular-nums;
  }
  .cb-big-cell.hi b {
    color: var(--lime);
  }
  .cb-big-cell span {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .cb-big-cell p {
    margin-top: 1.25rem;
    font-family: var(--display);
    font-size: 1.1rem;
  }
  .cb-big-cell em {
    font-style: normal;
    color: var(--grey);
    font-size: 0.9rem;
  }
  .cb-assume {
    padding-top: 1rem;
    font-size: 0.85rem;
    color: var(--grey);
  }
  .cb-assume summary {
    cursor: pointer;
    color: var(--white);
  }
  .cb-assume ol {
    list-style: decimal;
    padding-left: 1.2rem;
    margin-top: 0.75rem;
    columns: 2;
    column-gap: 3rem;
  }

  /* --- EV --- */
  .cb-ev {
    margin-top: clamp(40px, 5vw, 72px);
    display: grid;
  }
  .cb-ev-media {
    display: grid;
    grid-template-columns: 1.4fr 240px 1fr;
    gap: 24px;
    align-items: start;
  }
  .cb-ev-media figure {
    margin: 0;
  }
  .cb-ev-media figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .cb-ev-media figure:first-child img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .cb-ev-media figcaption {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--grey);
  }
  .cb-ev-phone {
    background: var(--lift);
    padding: 8px;
    border-radius: 26px;
  }
  .cb-ev-phone img {
    border-radius: 18px;
  }
  .cb-ev-phone figcaption {
    text-align: center;
    padding: 0 0.25rem 0.25rem;
  }
  .cb-ev-who {
    display: grid;
    gap: 2rem;
  }
  .cb-ev-who ul,
  .cb-lane-item + .cb-lane-item {
    display: grid;
    gap: 0.5rem;
  }
  .cb-ev-who li {
    position: relative;
    padding-left: 1.3rem;
    color: var(--soft);
  }
  .cb-ev-who li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
  }

  /* --- app --- */
  .cb-app {
    background: var(--ink-2);
  }
  .cb-app-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.8fr);
    grid-template-areas:
      'head phone'
      'list phone';
    column-gap: clamp(40px, 6vw, 112px);
    align-items: start;
  }
  .cb-app-head {
    grid-area: head;
  }
  .cb-app-list {
    grid-area: list;
  }
  .cb-app-feats {
    margin-top: clamp(32px, 4vw, 56px);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cb-app-feats button {
    background: var(--ink-2);
    color: var(--white);
    border: 0;
    border-radius: 0;
    padding: 1.1rem 1.2rem 1.25rem;
    box-shadow: none;
    transform: none !important;
  }
  .cb-app-feats button:hover {
    background: var(--lift);
  }
  .cb-app-feats button.on {
    background: var(--lift);
    box-shadow: inset 3px 0 0 var(--lime);
  }
  .cb-app-feats .tp-ico {
    padding-top: 0.1rem;
  }
  .cb-app-feats b {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.05rem;
  }
  .cb-app-feats .tp-desc {
    color: var(--soft);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .cb-app-phone {
    grid-area: phone;
    position: sticky;
    top: 96px;
  }
  /* phone in Parkstory colours */
  .cb .tp-phone {
    background: #0b1d15;
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 70%),
      inset 0 0 0 2px #24443a;
  }
  .cb .tp-phone .ph-notch {
    background: #0b1d15;
  }
  .cb .tp-phone .ph-head {
    background: var(--ink-2);
    font-family: var(--display);
  }
  .cb .tp-phone .ph-body {
    background: #f3f2ec;
    font-family: var(--text);
  }
  .cb .tp-phone .pc em.ok,
  .cb .tp-phone .pc .lbl,
  .cb .tp-phone .ph-btn.ghost,
  .cb .tp-phone .ph-tabs button.on {
    color: #1f6b3f;
  }
  .cb .tp-phone .pc em.ok,
  .cb .tp-phone .ph-tabs button.on {
    background: rgb(47 148 82 / 14%);
  }
  .cb .tp-phone .ph-btn,
  .cb .tp-phone .bar i,
  .cb .tp-phone .tg.on,
  .cb .tp-phone .vl-steps div.on::before {
    background: #2f9452;
    border-color: #2f9452;
  }
  .cb .tp-phone .ph-btn.ghost {
    background: #fff;
    border-color: rgb(47 148 82 / 45%);
  }
  .cb .tp-phone .pc-act {
    border-color: rgb(47 148 82 / 40%);
  }
  .cb .tp-phone .kpis div,
  .cb .tp-phone .toast {
    background: var(--ink-2);
  }
  .cb-ops {
    margin-top: clamp(80px, 10vw, 144px);
  }
  .cb-ops .cb-four {
    margin-bottom: 0;
    margin-top: 1.5rem;
  }

  /* --- quality control --- */
  .cb-qc {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 6vw, 112px);
    align-items: center;
    margin-top: clamp(80px, 10vw, 144px);
    padding-top: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--line);
  }
  .cb-qc-list {
    display: grid;
    margin-top: 2rem;
    border-top: 1px solid var(--line-2);
  }
  .cb-qc-list li {
    padding: 0.95rem 0 0.95rem 1.6rem;
    border-bottom: 1px solid var(--line);
    position: relative;
    color: var(--soft);
  }
  .cb-qc-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--lime);
    font-weight: 600;
  }
  .cb-qc-list b {
    color: var(--white);
    font-weight: 600;
  }
  /* the portrait video always fits the screen: never taller than the viewport */
  .cb-qc-video {
    position: relative;
    margin: 0;
    justify-self: center;
    width: min(100%, calc(min(78vh, 760px) * 0.8));
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: #000;
    border: 1px solid var(--line);
  }
  .cb-qc-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .cb-rec {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: rgb(4 13 9 / 80%);
    padding: 0.35rem 0.6rem;
    border-radius: 3px;
  }
  .cb-rec i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e5484d;
    animation: cbRec 1.4s infinite;
  }
  @keyframes cbRec {
    50% {
      opacity: 0.25;
    }
  }
  .cb-qc-video figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 1rem 0.8rem;
    font-size: 0.82rem;
    background: linear-gradient(transparent, rgb(4 13 9 / 92%));
  }

  /* --- flow: next-chapter links and active chapter --- */
  .cb-nextch {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: fit-content;
    margin-top: clamp(56px, 7vw, 104px);
    padding: 0.9rem 1.2rem;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    text-decoration: none;
    color: var(--soft);
    font-size: 0.9rem;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .cb-nextch span {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .cb-nextch b {
    color: var(--lime);
    font-weight: 600;
  }
  .cb-nextch i {
    font-style: normal;
    color: var(--lime);
    transition: transform 0.2s;
  }
  .cb-nextch:hover {
    border-color: var(--lime);
    color: var(--white);
  }
  .cb-nextch:hover i {
    transform: translateY(3px);
  }
  .cb-chapters a.on {
    color: var(--white);
  }
  .cb-chapters a.on i {
    color: var(--lime);
  }
  .cb-amber {
    color: var(--amber);
  }

  /* --- journey (arrival to pickup) --- */
  .cb-journey {
    margin-top: clamp(64px, 8vw, 120px);
  }
  .cb-journey ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }
  .cb-journey ol::before {
    content: '';
    position: absolute;
    left: 18px;
    right: 18px;
    top: 18px;
    height: 1px;
    background: linear-gradient(90deg, var(--lime), rgb(184 240 60 / 20%));
  }
  .cb-journey-n {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 37px;
    height: 37px;
    border-radius: 50%;
    background: var(--black);
    border: 1.5px solid var(--lime);
    color: var(--lime);
    font-family: var(--display);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .cb-journey h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.2rem;
  }
  .cb-journey p {
    margin-top: 0.5rem;
    color: var(--soft);
    font-size: 0.95rem;
  }
  .cb-audience {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: clamp(56px, 7vw, 104px);
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cb-audience li {
    background: var(--black);
    padding: 1.6rem 1.75rem 1.9rem;
  }
  .cb-audience .cb-label {
    display: inline-block;
    border: 0;
    padding: 0;
    margin-bottom: 0.75rem;
  }
  .cb-audience h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.3rem;
  }
  .cb-audience p {
    margin-top: 0.5rem;
    color: var(--soft);
    font-size: 0.95rem;
  }

  /* --- power outage --- */
  .cb-power {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 3vw, 48px);
    align-items: center;
    margin-top: clamp(64px, 8vw, 120px);
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid rgb(245 165 36 / 40%);
    background: rgb(245 165 36 / 4%);
    border-radius: 4px;
  }
  .cb-power-bolt {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--amber);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cb-power h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .cb-power p {
    margin-top: 0.75rem;
    color: var(--soft);
  }
  .cb-power ul {
    display: grid;
    gap: 0.6rem;
  }
  .cb-power li {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-size: 0.92rem;
    color: var(--soft);
  }
  .cb-power li b {
    color: var(--white);
  }

  /* --- third dimension --- */
  .cb-stacker {
    margin-top: clamp(48px, 6vw, 88px);
  }
  .cb-whyz {
    margin-top: clamp(40px, 5vw, 72px);
    padding-top: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--line);
  }
  .cb-six,
  .cb-eight {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: clamp(40px, 5vw, 72px);
  }
  .cb-six {
    grid-template-columns: repeat(3, 1fr);
  }
  .cb-eight {
    grid-template-columns: repeat(4, 1fr);
  }
  .cb-six li,
  .cb-eight li {
    background: var(--black);
    padding: 1.5rem 1.6rem 1.75rem;
  }
  .cb-chain-sec .cb-eight li,
  .cb-app .cb-six li {
    background: var(--ink-2);
  }
  .cb-six h3,
  .cb-eight h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.15rem;
  }
  .cb-six p,
  .cb-eight p {
    margin-top: 0.45rem;
    color: var(--soft);
    font-size: 0.92rem;
  }
  .cb-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--lime);
    color: var(--lime);
    font-size: 0.8rem;
    margin-bottom: 0.9rem;
  }
  .cb-foot-line {
    margin-top: 1.5rem;
    font-size: 1.05rem;
    color: var(--soft);
    max-width: 80ch;
  }
  .cb-foot-line b {
    color: var(--lime);
    font-weight: 600;
    margin-right: 0.3rem;
  }
  .cb-econ-block {
    margin-top: clamp(80px, 10vw, 144px);
    padding-top: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--line);
  }
  .cb-econ-block .cb-big {
    margin-top: clamp(40px, 5vw, 64px);
  }

  /* --- driver --- */
  .cb-driver {
    margin-top: clamp(80px, 10vw, 144px);
  }

  /* --- value chain --- */
  .cb-chain-sec {
    overflow: hidden;
    background: var(--ink-2);
  }
  .cb-chain-sec > .cb-wrap {
    position: relative;
  }
  .cb-chain {
    margin-top: clamp(56px, 7vw, 104px);
    padding: clamp(28px, 3vw, 44px) clamp(20px, 3vw, 40px);
    border: 1px solid rgb(184 240 60 / 35%);
    background: rgb(184 240 60 / 3%);
    border-radius: 4px;
  }
  .cb-chain ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .cb-chain ol::before {
    content: '';
    position: absolute;
    left: 7px;
    right: 7px;
    top: 7px;
    height: 2px;
    background: var(--lime);
  }
  .cb-chain li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .cb-chain-node {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 4px var(--ink-2);
    margin-bottom: 0.8rem;
  }
  .cb-chain b {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.2;
  }
  .cb-chain em {
    font-style: normal;
    font-size: 0.78rem;
    color: var(--grey);
    line-height: 1.35;
  }
  .cb-chain small {
    margin-top: 0.35rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .cb-chain-statement {
    margin-top: clamp(28px, 3vw, 40px);
    padding-top: 1.25rem;
    border-top: 1px solid rgb(184 240 60 / 20%);
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.2vw, 2rem);
    letter-spacing: -0.02em;
  }
  .cb-heritage-copy {
    margin-top: clamp(48px, 6vw, 88px);
    align-items: start;
  }
  .cb-banner {
    position: relative;
    margin: clamp(56px, 7vw, 104px) 0 0;
    height: clamp(260px, 38vw, 520px);
    overflow: hidden;
    border-radius: 4px;
  }
  .cb-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    filter: grayscale(0.4) contrast(1.05) brightness(0.85);
  }
  .cb-banner figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 3rem clamp(20px, 3vw, 40px) 1.5rem;
    background: linear-gradient(transparent, rgb(4 13 9 / 92%));
  }
  .cb-banner b {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    letter-spacing: -0.02em;
  }
  .cb-banner span {
    color: var(--soft);
  }
  .cb-plants {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: clamp(64px, 8vw, 120px);
  }
  .cb-plant {
    border: 1px solid var(--line);
    background: var(--black);
    padding: 1.1rem;
    border-radius: 4px;
  }
  .cb-plant-head {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    margin: 0.2rem 0.2rem 1rem;
  }
  .cb-flag {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--lime);
    color: var(--lime);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .cb-plant-head b {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.15rem;
  }
  .cb-plant-head span {
    font-size: 0.85rem;
    color: var(--grey);
  }
  .cb-plant-pics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: clamp(180px, 22vw, 300px) clamp(110px, 12vw, 170px);
    gap: 6px;
  }
  .cb-plant-pics figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 3px;
  }
  .cb-plant-pics figure.big {
    grid-column: 1 / span 3;
  }
  .cb-plant-pics img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.5);
    transition: filter 0.5s;
  }
  .cb-plant-pics figure:hover img {
    filter: none;
  }
  .cb-plant-pics figcaption {
    position: absolute;
    left: 8px;
    bottom: 8px;
    font-size: 0.68rem;
    background: rgb(4 13 9 / 85%);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
  }
  .cb-plant-caps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem 1rem;
    margin: 1rem 0.2rem 0.2rem;
  }
  .cb-plant-caps li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.85rem;
    color: var(--soft);
  }
  .cb-plant-caps li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
  }
  .cb-yt a {
    color: var(--lime);
  }

  @media (max-width: 1100px) {
    .cb-chain ol {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      row-gap: 2rem;
    }
    .cb-chain ol::before {
      display: none;
    }
    .cb-eight {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 960px) {
    .cb-journey ol,
    .cb-six {
      grid-template-columns: 1fr 1fr;
    }
    .cb-journey ol::before {
      display: none;
    }
    .cb-audience,
    .cb-plants,
    .cb-power {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .cb-journey ol,
    .cb-six,
    .cb-eight,
    .cb-plant-caps {
      grid-template-columns: 1fr;
    }
    .cb-chain ol {
      grid-template-columns: 1fr 1fr;
    }
    .cb-plant-pics {
      grid-template-rows: 200px 110px;
    }
  }

  /* --- 09 innovation --- */
  .cb-innov {
    background: var(--ink-2);
  }
  .cb-disciplines li {
    background: var(--ink-2) !important;
  }
  .cb-disciplines .cb-n {
    display: block;
    margin-bottom: 0.8rem;
  }
  .cb-ai {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 96px);
    align-items: center;
    margin-top: clamp(72px, 9vw, 136px);
  }
  .cb-ai-viz {
    position: relative;
    margin: 0;
    height: clamp(260px, 28vw, 380px);
    border: 1px solid rgb(184 240 60 / 35%);
    border-radius: 4px;
    overflow: hidden;
    --tf-bg: #07150f;
    --tf-line: rgb(184 240 60 / 9%);
    --tf-car: #24443a;
    --tf-car-2: #173025;
    --tf-glass: rgb(0 0 0 / 45%);
    --tf-accent: #b8f03c;
  }
  .cb-ai-viz figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: rgb(4 13 9 / 85%);
    padding: 0.4rem 0.7rem;
    border-radius: 3px;
  }
  .cb-ai-viz figcaption i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    animation: cbRec 1.6s infinite;
  }
  .cb-strategy {
    margin-top: clamp(72px, 9vw, 136px);
  }
  .cb-strategy .cb-pillars {
    margin-top: 1.5rem;
  }
  .cb-strategy .cb-pillars li {
    background: var(--ink-2);
  }

  /* --- 09 our DNA --- */
  .cb-legacy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: clamp(56px, 7vw, 104px);
  }
  .cb-leg {
    background: var(--ink-2);
    padding: clamp(1.5rem, 3vw, 2.75rem);
  }
  .cb-leg-years {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(3.6rem, 7vw, 6.4rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--lime);
  }
  .cb-leg-years span {
    font-family: var(--text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--grey);
    margin-left: 0.6rem;
  }
  .cb-leg h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    margin-top: 1.25rem;
  }
  .cb-leg-text {
    color: var(--soft);
    margin-top: 0.4rem;
    max-width: 44ch;
  }
  .cb-leg ol {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0 0 0 1.5rem;
    border-left: 1px solid rgb(184 240 60 / 35%);
    display: grid;
    gap: 0.9rem;
  }
  .cb-leg li {
    position: relative;
    font-weight: 500;
    line-height: 1.35;
  }
  .cb-leg li span {
    display: block;
    font-weight: 400;
    font-size: 0.88rem;
    color: var(--grey);
  }
  .cb-leg li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 5px);
    top: 0.4em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--lime);
    background: var(--ink-2);
  }
  .cb-leg li:last-child::before {
    background: var(--lime);
  }
  .cb-merge {
    display: grid;
    justify-items: center;
  }
  .cb-merge > svg {
    width: 50%;
    height: 64px;
    display: block;
  }
  .cb-merge-box {
    max-width: 720px;
    text-align: center;
    border: 1px solid rgb(184 240 60 / 45%);
    border-radius: 4px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--black);
  }
  .cb-merge-mark {
    display: inline-block;
    font-size: clamp(2rem, 3.4vw, 2.8rem);
  }
  .cb-merge-box b {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.9vw, 1.6rem);
    letter-spacing: -0.02em;
    margin-top: 0.9rem;
  }
  .cb-merge-box p {
    color: var(--soft);
    margin-top: 0.75rem;
  }
  .cb-founders {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 120px);
    align-items: center;
    margin-top: clamp(72px, 9vw, 136px);
  }
  .cb-founders ul {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cb-founders li {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    background: var(--ink-2);
    padding: 1.1rem 1.4rem;
  }
  .cb-av {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--lime);
    color: var(--lime);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--display);
    font-weight: 500;
  }
  .cb-founders li b,
  .cb-sites b {
    display: block;
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.15rem;
  }
  .cb-founders li span:not(.cb-av),
  .cb-sites li span:not(.cb-flag) {
    color: var(--grey);
    font-size: 0.9rem;
  }
  .cb-dna-sub {
    margin-top: clamp(72px, 9vw, 136px);
    padding-top: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--line);
  }
  .cb-people {
    margin-top: clamp(72px, 9vw, 136px);
    padding-top: clamp(56px, 7vw, 104px);
    border-top: 1px solid var(--line);
  }
  .cb-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: clamp(40px, 5vw, 72px);
  }
  .cb-stats div {
    background: var(--ink-2);
    padding: 1.5rem 1.75rem;
  }
  .cb-stats b {
    display: block;
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(3.4rem, 6vw, 5.6rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: var(--lime);
  }
  .cb-stats span {
    color: var(--soft);
  }
  .cb-sites {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .cb-sites li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .cb-today-list {
    display: grid;
    gap: 0.85rem;
  }
  .cb-today-list li {
    position: relative;
    padding-left: 1.3rem;
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .cb-today-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
  }
  .cb-ambition {
    margin-top: 2rem;
  }
  .cb-dna-quote {
    margin: clamp(72px, 9vw, 136px) auto 0;
    max-width: 980px;
    text-align: center;
  }
  .cb-dna-quote p {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.6rem, 3vw, 2.8rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .cb-close,
  .cb-sign {
    font-family: var(--display);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .cb-close {
    font-size: clamp(1.8rem, 3.4vw, 3.2rem);
    line-height: 1.08;
    max-width: 24ch;
    margin-top: clamp(56px, 7vw, 104px);
  }
  .cb-sign {
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    margin-top: 2rem;
    max-width: 48ch;
  }
  @media (max-width: 960px) {
    .cb-legacy,
    .cb-founders {
      grid-template-columns: 1fr;
    }
    .cb-merge > svg {
      display: none;
    }
    .cb-merge {
      margin-top: 1.5rem;
    }
  }
  @media (max-width: 640px) {
    .cb-stats,
    .cb-sites {
      grid-template-columns: 1fr;
    }
  }

  /* --- 11 delivery and service --- */
  .cb-phases ol {
    grid-template-columns: repeat(5, 1fr);
    margin-top: 1rem;
  }
  .cb-lead-bar {
    position: relative;
    height: 2rem;
    display: flex;
    align-items: center;
  }
  .cb-lead-bar::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: linear-gradient(90deg, var(--lime), rgb(184 240 60 / 40%));
  }
  .cb-lead-bar span {
