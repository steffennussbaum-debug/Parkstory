---
/**
 * Concept B — Technological Disruption, in the Parkstory corporate identity.
 *
 * Cinematic and immersive, but engineered rather than sporty: Parkstory's
 * Outfit (display) and Inter (text) in sentence case, hairline precision rules,
 * deep green-black with lime used as a signal only. Opens with the exploding-P
 * wordmark over a live TilePark field; chapter 04 makes the case for why
 * TilePark is the disruptor.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ConceptLayout from '~/layouts/ConceptLayout.astro';
import TileField from '~/components/concepts/TileField.astro';
import ParkstoryMark from '~/components/concepts/ParkstoryMark.astro';
import DecadeTimeline from '~/components/concepts/DecadeTimeline.astro';
import GridDemo from '~/components/tilepark/GridDemo.astro';
import StackerDemo from '~/components/tilepark/StackerDemo.astro';
import EvDemo from '~/components/tilepark/EvDemo.astro';
import BeesFigure from '~/components/tilepark/BeesFigure.astro';
import AppPhone from '~/components/tilepark/AppPhone.astro';
import {
  shift,
  question,
  breakthrough,
  edge,
  economics,
  ev,
  next,
  decision,
  nature,
  app,
  quality,
  journey,
  audience,
  third,
  power,
  driver,
  valueChain,
  innovation,
  delivery,
  dna,
} from '~/data/concepts';

import drives from '~/assets/images/tilepark/gastonia-drive-assembly.webp';
import welding from '~/assets/images/tilepark/kehl-welding.webp';
import cnc from '~/assets/images/tilepark/gastonia-cnc.webp';
import bending from '~/assets/images/tilepark/kehl-bending.webp';
import wheels from '~/assets/images/tilepark/gastonia-wheels.webp';
import evCharging from '~/assets/images/tilepark/ev-charging.webp';
import evApp from '~/assets/images/tilepark/ev-app-screen.webp';
import conveyors from '~/assets/images/tilepark/conveyors-installed.webp';
import kehlPlant from '~/assets/images/tilepark/kehl-plant.webp';
import gastPlant from '~/assets/images/tilepark/gastonia-plant.webp';
import steel from '~/assets/images/tilepark/kehl-steel.webp';

import '@fontsource-variable/inter';
import '@fontsource-variable/outfit';
import '~/assets/styles/tilepark.css';
import '~/assets/styles/concept-demos.css';

const questionWords = question.title.split(' ');
const ex = economics.example.rows;
// photos per plant: [image, caption, object-position]
const plantPics = [
  [
    [kehlPlant, 'Our plant in Kehl', '50% 55%'],
    [welding, 'Robotic welding', '50% 35%'],
    [bending, 'CNC bending', '75% 55%'],
    [steel, 'Galvanised steel', '50% 50%'],
  ],
  [
    [drives, 'TilePark conveyor drive assembly · Gastonia', '50% 52%'],
    [gastPlant, 'Our plant', '55% 60%'],
    [cnc, 'CNC machining', '50% 50%'],
    [wheels, 'Drive wheel units', '50% 50%'],
  ],
];
const chapters = [
  ['01', 'The shift', '#shift'],
  ['02', 'The question', '#question'],
  ['03', 'Breakthrough', '#breakthrough'],
  ['04', 'Why we lead', '#edge'],
  ['05', 'Third dimension', '#economics'],
  ['06', 'EV charging', '#ev-charging'],
  ['07', 'The app', '#app'],
  ['08', 'What comes next', '#next'],
  ['09', 'Our DNA', '#dna'],
  ['10', 'Value chain', '#heritage'],
  ['11', 'Service', '#delivery'],
  ['12', 'The decision', '#decision'],
];
// value-chain facts not already covered by the steps, the quality section or chapter 11
const chainPillars = [
  ...valueChain.pillars.filter((p) => ['Spare parts for 30+ years', 'Every component serialised'].includes(p.k)),
  {
    k: 'Materials and tolerances',
    v: 'What each part is made of and why, with precision that holds from the first unit to the last.',
  },
  { k: 'Quality built in', v: 'Built into every production step, not added at the end.' },
];
// chapters shown in the top navigation
const navChapters = chapters.filter((_, i) => [2, 3, 4, 5, 6, 8, 9, 10].includes(i));
---

<ConceptLayout
  title="Parkstory — Concept B · Technological Disruption"
  description={shift.lead}
  bodyClass="cb"
  current="technological-disruption"
>
  <header class="cb-nav">
    <a href="#top" class="cb-mark" aria-label="Parkstory, back to top"><ParkstoryMark /></a>
    <nav aria-label="Chapters" class="cb-chapters">
      {
        navChapters.map(([n, t, h]) => (
          <a href={h}>
            <i>{n}</i>
            {t}
          </a>
        ))
      }
    </nav>
    <a href="#decision" class="cb-nav-cta">Technology briefing</a>
  </header>

  <main id="top">
    <!-- 01 THE SHIFT -->
    <section class="cb-hero" id="shift">
      <div class="cb-field" aria-hidden="true">
        <div class="cb-field-plane"><TileField cell={58} density={0.84} rate={9} accentShare={0.14} /></div>
      </div>
      <div class="cb-hero-shade" aria-hidden="true"></div>
      <div class="cb-wrap cb-hero-in">
        <ParkstoryMark variant="swarm" class="cb-word" />
        <div class="cb-hero-grid">
          <h1 class="cb-rise" style="--d:.7s">
            Your vision needs space. <span class="cb-lime">We unlock it.</span>
          </h1>
          <div class="cb-rise cb-hero-side" style="--d:.9s">
            <p class="cb-lead">{shift.lead}</p>
            <a href="#question" class="cb-scroll"><i></i>Scroll to explore</a>
          </div>
        </div>
      </div>
    </section>

    <section class="cb-sec cb-points">
      <div class="cb-wrap">
        <p class="cb-intro" data-reveal>{shift.intro}</p>
        <ol class="cb-three">
          {
            shift.points.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${0.1 * i}s`}>
                <span class="cb-n">{p.n}</span>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ol>
        <a class="cb-nextch" href={chapters[1][2]}><span>Next</span><b>{chapters[1][0]}</b>{chapters[1][1]}<i>↓</i></a>
      </div>
    </section>

    <!-- 02 THE QUESTION -->
    <section class="cb-question" id="question">
      <div class="cb-sticky">
        <div class="cb-wrap">
          <p class="cb-kicker"><b>02</b>{question.eyebrow}</p>
          <h2 class="cb-q" data-words>
            {questionWords.map((w) => <span>{w} </span>)}
          </h2>
        </div>
      </div>
    </section>

    <section class="cb-sec cb-tight">
      <div class="cb-wrap">
        <p class="cb-body cb-body--wide" data-reveal>{question.body}</p>
        <p class="cb-asklabel" data-reveal>Five questions to ask every supplier</p>
        <ol class="cb-list cb-ask">
          {
            question.constraints.map((c, i) => (
              <li data-reveal style={`--reveal-delay:${0.06 * i}s`}>
                <span class="cb-n">0{i + 1}</span>
                <h3>{c.k}</h3>
                <p>{c.v}</p>
              </li>
            ))
          }
        </ol>
        <div class="cb-timeline">
          <p class="cb-kicker"><b>—</b>A decision measured in decades</p>
          <DecadeTimeline />
          <p class="cb-note">{question.timeline.note}</p>
        </div>
        <a class="cb-nextch" href={chapters[2][2]}><span>Next</span><b>{chapters[2][0]}</b>{chapters[2][1]}<i>↓</i></a>
      </div>
    </section>

    <!-- 03 THE BREAKTHROUGH -->
    <section class="cb-cinema" id="breakthrough">
      <video src="/videos/realvid.mp4" autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
      <div class="cb-cinema-shade" aria-hidden="true"></div>
      <div class="cb-wrap cb-cinema-in">
        <p class="cb-kicker" data-reveal><b>03</b>{breakthrough.eyebrow}</p>
        <h2 class="cb-h2" data-reveal>Not a better machine. <span class="cb-lime">A different architecture.</span></h2>
        <p class="cb-tag">Real footage · TilePark in operation, Munich</p>
      </div>
    </section>

    <section class="cb-sec">
      <div class="cb-wrap">
        <div class="cb-split">
          <p class="cb-statement" data-reveal>
            Hundreds of independent conveyors. No central control. <span class="cb-lime">One shared goal:</span> getting your
            car to you by the shortest route.
          </p>
          <p class="cb-body" data-reveal>{breakthrough.body}</p>
        </div>
        <ol class="cb-four">
          {
            breakthrough.principles.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                <span class="cb-n">{p.n}</span>
                <h3>{p.k}</h3>
                <p>{p.v}</p>
              </li>
            ))
          }
        </ol>
        <div class="cx-demos"><GridDemo /></div>
        <p class="cb-note">{breakthrough.patent}</p>

        <div class="cb-journey">
          <p class="cb-kicker" data-reveal><b>—</b>From arrival to pickup</p>
          <ol>
            {
              journey.map((j, i) => (
                <li data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                  <span class="cb-journey-n">{i + 1}</span>
                  <h3>{j.k}</h3>
                  <p>{j.v}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <ul class="cb-audience">
          {
            audience.map((a, i) => (
              <li data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                <span class="cb-label">{a.who}</span>
                <h3>{a.k}</h3>
                <p>{a.v}</p>
              </li>
            ))
          }
        </ul>

        <div class="cb-nature">
          <div class="cb-split">
            <div>
              <p class="cb-kicker" data-reveal><b>—</b>{nature.eyebrow}</p>
              <h3 class="cb-h3" data-reveal>We asked the bees <span class="cb-lime">how to park.</span></h3>
            </div>
            <p class="cb-body" data-reveal>{nature.body}</p>
          </div>
          <div class="cx-demos" data-reveal><BeesFigure /></div>
          <ol class="cb-rules">
            {
              nature.rules.map((r, i) => (
                <li data-reveal style={`--reveal-delay:${0.06 * i}s`}>
                  <span class="cb-n">{String(i + 1).padStart(2, '0')}</span>
                  <p class="cb-rule-q">“{r.q}”</p>
                  <p class="cb-rule-b">
                    <b>The bees</b>
                    {r.bees}
                  </p>
                  <p class="cb-rule-t">
                    <b>TilePark</b>
                    {r.tp}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>
        <a class="cb-nextch" href={chapters[3][2]}><span>Next</span><b>{chapters[3][0]}</b>{chapters[3][1]}<i>↓</i></a>
      </div>
    </section>

    <!-- 04 WHY TILEPARK LEADS -->
    <section class="cb-sec cb-edge" id="edge">
      <div class="cb-grid-bg" aria-hidden="true"></div>
      <div class="cb-wrap">
        <p class="cb-kicker" data-reveal><b>04</b>{edge.eyebrow}</p>
        <h2 class="cb-h2" data-reveal>{edge.title} <span class="cb-lime">{edge.titleAccent}</span></h2>
        <p class="cb-body" data-reveal>{edge.body}</p>

        <ol class="cb-pillars">
          {
            edge.pillars.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                <span class="cb-pillar-n">{p.n}</span>
                <h3>{p.k}</h3>
                <p>{p.v}</p>
              </li>
            ))
          }
        </ol>

        <div class="cb-stack" data-reveal>
          <div class="cb-layer cb-layer--soft">
            <p class="cb-layer-h">
              <span>Software</span><em>where the complexity lives: adaptive, updateable</em>
            </p>
            <ul>{edge.software.map((s) => <li>{s}</li>)}</ul>
          </div>
          <div class="cb-layer-join" aria-hidden="true">
            {Array.from({ length: 12 }, () => <i />)}
          </div>
          <div class="cb-layer cb-layer--steel">
            <p class="cb-layer-h">
              <span>Mechanics</span><em>kept deliberately simple: standard, robust, serviceable</em>
            </p>
            <ul>{edge.mechanics.map((s) => <li>{s}</li>)}</ul>
          </div>
          <figure class="cb-stack-img">
            <Image
              src={wheels}
              alt="TilePark drive wheel units with polyurethane wheels"
              widths={[400, 700]}
              sizes="(max-width: 960px) 100vw, 30vw"
            />
            <figcaption>Drive wheel units, Gastonia</figcaption>
          </figure>
        </div>

        <div class="cb-power" data-reveal>
          <div class="cb-power-bolt" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30"
              ><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" fill="#f5a524"></path></svg
            >
          </div>
          <div>
            <h3>{power.title} <span class="cb-amber">{power.titleAccent}</span></h3>
            <p>{power.body}</p>
          </div>
          <ul>
            {
              power.points.map((pt) => (
                <li>
                  <b>{pt.k}</b> {pt.v}
                </li>
              ))
            }
          </ul>
        </div>
        <a class="cb-nextch" href={chapters[4][2]}><span>Next</span><b>{chapters[4][0]}</b>{chapters[4][1]}<i>↓</i></a>
      </div>
    </section>

    <!-- 05 THE THIRD DIMENSION AND THE ECONOMICS OF CHANGE -->
    <section class="cb-sec" id="economics">
      <div class="cb-wrap">
        <p class="cb-kicker" data-reveal><b>05</b>{third.eyebrow}</p>
        <div class="cb-split">
          <h2 class="cb-h2" data-reveal>{third.title} <span class="cb-lime">{third.titleAccent}</span></h2>
          <p class="cb-body" data-reveal>{third.body}</p>
        </div>
        <div class="cx-demos cb-stacker"><StackerDemo /></div>
        <ol class="cb-four">
          {
            third.steps.map((st, i) => (
              <li data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                <span class="cb-n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{st.k}</h3>
                <p>{st.v}</p>
              </li>
            ))
          }
        </ol>

        <div class="cb-whyz">
          <div class="cb-split">
            <h3 class="cb-h3" data-reveal>{third.whyTitle} <span class="cb-lime">{third.whyAccent}</span></h3>
            <p class="cb-body" data-reveal>{third.whyBody}</p>
          </div>
          <ul class="cb-six">
            {
              third.why.map((w, i) => (
                <li data-reveal style={`--reveal-delay:${0.05 * i}s`}>
                  <h3>{w.k}</h3>
                  <p>{w.v}</p>
                </li>
              ))
            }
          </ul>
          <p class="cb-foot-line" data-reveal>
            <b>It unlocks height.</b>
            {third.whyFoot.replace('It unlocks height. ', '')}
          </p>
        </div>

        <div class="cb-econ-block">
          <p class="cb-kicker" data-reveal><b>—</b>{economics.eyebrow}</p>
          <h3 class="cb-h3" data-reveal>{economics.title}</h3>
          <div class="cb-big" data-reveal>
            <p class="cb-big-cap">Same grid, same 297 m². {economics.example.caption}</p>
            <div class="cb-big-row">
              {
                ex.map((r, i) => (
                  <div class:list={['cb-big-cell', { hi: i === ex.length - 1 }]}>
                    <b>{r.cars}</b>
                    <span>cars</span>
                    <p>{r.config}</p>
                    <em>{r.perCar} per car</em>
                  </div>
                ))
              }
            </div>
            <details class="cb-assume">
              <summary>Assumptions behind these numbers</summary>
              <ol>{economics.example.assumptions.map((a) => <li>{a}</li>)}</ol>
            </details>
          </div>
          <p class="cb-foot-line cb-ambition" data-reveal>{economics.ambition}</p>
          <ul class="cb-five">
            {
              [...economics.levers.filter((l) => l.k !== 'Lighter construction'), economics.community].map((l, i) => (
                <li data-reveal style={`--reveal-delay:${0.05 * i}s`}>
                  <h3>{l.k}</h3>
                  <p>{l.v}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <a class="cb-nextch" href={chapters[5][2]}><span>Next</span><b>{chapters[5][0]}</b>{chapters[5][1]}<i>↓</i></a>
      </div>
    </section>

    <!-- 06 INTEGRATED EV CHARGING -->
    <section class="cb-cinema cb-cinema--ev" id="ev-charging">
      <video src="/videos/ev-connection.mp4" autoplay muted loop playsinline preload="metadata" aria-hidden="true"
      ></video>
      <div class="cb-cinema-shade" aria-hidden="true"></div>
      <div class="cb-wrap cb-cinema-in">
        <p class="cb-kicker" data-reveal><b>06</b>{ev.eyebrow}</p>
        <h2 class="cb-h2" data-reveal>{ev.title} <span class="cb-lime">{ev.titleAccent}</span></h2>
        <p class="cb-tag">Real footage · connecting a car to the charging point on its pallet</p>
      </div>
    </section>

    <section class="cb-sec cb-tight">
      <div class="cb-wrap">
        <p class="cb-body cb-body--wide" data-reveal>{ev.body}</p>
        <div class="cx-demos cb-ev"><EvDemo /></div>
        <ul class="cb-four cb-four--plain">
          {
            ev.features.map((f, i) => (
              <li data-reveal style={`--reveal-delay:${0.06 * i}s`}>
                <h3>{f.k}</h3>
                <p>{f.v}</p>
              </li>
            ))
          }
        </ul>
        <div class="cb-ev-media">
          <figure data-reveal>
            <Image
              src={evCharging}
              alt="Electric car charging on a TilePark pallet"
              widths={[600, 900]}
              sizes="(max-width: 760px) 100vw, 60vw"
            />
            <figcaption>
              An EV charging on its pallet: the cable plugs into the socket built into the pallet.
            </figcaption>
          </figure>
          <figure class="cb-ev-phone" data-reveal style="--reveal-delay:.1s">
            <Image src={evApp} alt="Charging session in the Parkstory app" widths={[460]} sizes="240px" />
            <figcaption>Real app screen: charging session with live kWh</figcaption>
          </figure>
          <div class="cb-ev-who" data-reveal style="--reveal-delay:.2s">
            <div>
              <p class="cb-label">For the driver</p>
              <ul>{ev.driver.map((d) => <li>{d}</li>)}</ul>
            </div>
            <div>
              <p class="cb-label">For the owner and operator</p>
              <ul>{ev.owner.map((d) => <li>{d}</li>)}</ul>
            </div>
          </div>
        </div>
        <a class="cb-nextch" href={chapters[6][2]}><span>Next</span><b>{chapters[6][0]}</b>{chapters[6][1]}<i>↓</i></a>
      </div>
    </section>

    <!-- 07 THE APP -->
    <section class="cb-sec cb-app" id="app">
      <div class="cb-wrap" data-app-root>
        <div class="cb-app-grid">
          <div class="cb-app-head">
            <p class="cb-kicker" data-reveal><b>07</b>{app.eyebrow}</p>
            <h2 class="cb-h2" data-reveal>{app.title} <span class="cb-lime">{app.titleAccent}</span></h2>
            <p class="cb-body" data-reveal>{app.body}</p>
          </div>
          <AppPhone class="cb-app-phone" />
          <div class="cb-app-list">
            <div class="tp-app-feats cb-app-feats">
              {
                app.features.map((f, i) => (
                  <button data-t={f.t} class:list={{ on: i === 0 }}>
                    <span class="tp-ico cb-n">{String(i + 1).padStart(2, '0')}</span>
                    <b>{f.k}</b>
                    <span class="tp-desc">{f.v}</span>
                  </button>
                ))
              }
            </div>
            <p class="cb-note">Tap a feature, or the tabs on the phone, to see the screen.</p>
          </div>
        </div>
        <div class="cb-ops">
          <p class="cb-kicker" data-reveal><b>—</b>For owners and operators: the same platform, one dashboard</p>
          <ul class="cb-four cb-four--plain">
            {
              app.operators.map((o, i) => (
                <li data-reveal style={`--reveal-delay:${0.06 * i}s`}>
                  <h3>{o.k}</h3>
                  <p>{o.v}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="cb-driver">
          <p class="cb-kicker" data-reveal><b>—</b>{driver.eyebrow}</p>
          <h3 class="cb-h3" data-reveal>{driver.title} <span class="cb-lime">{driver.titleAccent}</span></h3>
          <ul class="cb-six">
            {
              driver.items.map((d, i) => (
                <li data-reveal style={`--reveal-delay:${0.05 * i}s`}>
                  <h3>{d.k}</h3>
                  <p>{d.v}</p>
                </li>
              ))
            }
          </ul>
        </div>
        <a class="cb-nextch" href={chapters[7][2]}><span>Next</span><b>{chapters[7][0]}</b>{chapters[7][1]}<i>↓</i></a>
      </div>
    </section>

    <!-- 08 BUILT FOR WHAT COMES NEXT -->
    <section class="cb-sec" id="next">
      <div class="cb-wrap">
        <p class="cb-kicker" data-reveal><b>08</b>{next.eyebrow}</p>
        <div class="cb-split">
          <h2 class="cb-h2" data-reveal>{next.title}</h2>
          <p class="cb-body" data-reveal>{next.evolveBody}</p>
        </div>
        <div class="cb-lanes">
          <div class="cb-lane is-today" data-reveal>
            <p class="cb-badge"><i></i>Available today</p>
            <ul class="cb-today-list">{next.todayShort.map((t) => <li>{t}</li>)}</ul>
          </div>
          {
            [
              ['Continuous development', next.developing, 'dev'],
              ['Future direction', next.future, 'future'],
            ].map(([label, items, cls], i) => (
              <div class:list={['cb-lane', `is-${cls}`]} data-reveal style={`--reveal-delay:${0.1 * (i + 1)}s`}>
                <p class="cb-badge">
                  <i />
                  {label as string}
                </p>
                {(items as { k: string; v: string }[]).map((it) => (
                  <div class="cb-lane-item">
                    <h3>{it.k}</h3>
                    <p>{it.v}</p>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
        <p class="cb-foot-line" data-reveal><b>Built to last, designed to evolve.</b>{next.evolve}</p>
        <p class="cb-note">{next.adoption}</p>
        <a class="cb-nextch" href={chapters[8][2]}><span>Next</span><b>{chapters[8][0]}</b>{chapters[8][1]}<i>↓</i></a>
      </div>
    </section>

    <!-- 09 OUR DNA -->
    <section class="cb-sec cb-innov cb-dna" id="dna">
