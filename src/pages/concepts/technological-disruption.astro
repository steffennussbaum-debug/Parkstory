---
/**
 * Concept B — Technological Disruption, in the Parkstory corporate identity.
 * Bold, cinematic, high contrast. Parkstory's deep green-black, lime and mint,
 * the exploding-P wordmark as the opening, condensed display type, a live
 * TilePark field and scroll-driven motion.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ConceptLayout from '~/layouts/ConceptLayout.astro';
import TileField from '~/components/concepts/TileField.astro';
import ParkstoryMark from '~/components/concepts/ParkstoryMark.astro';
import DecadeTimeline from '~/components/concepts/DecadeTimeline.astro';
import GridDemo from '~/components/tilepark/GridDemo.astro';
import StackerDemo from '~/components/tilepark/StackerDemo.astro';
import EvDemo from '~/components/tilepark/EvDemo.astro';
import { shift, question, breakthrough, economics, next, heritage, decision } from '~/data/concepts';

import drives from '~/assets/images/tilepark/gastonia-drive-assembly.webp';
import welding from '~/assets/images/tilepark/kehl-welding.webp';
import cnc from '~/assets/images/tilepark/gastonia-cnc.webp';
import bending from '~/assets/images/tilepark/kehl-bending.webp';

import '@fontsource-variable/archivo/wdth.css';
import '~/assets/styles/tilepark.css';
import '~/assets/styles/concept-demos.css';

const questionWords = question.title.split(' ');
const constraintWord: Record<string, string> = {
  'Building design': 'Design',
  Space: 'Space',
  Flexibility: 'Change',
  Operations: 'Uptime',
};
const ex = economics.example.rows;
---

<ConceptLayout
  title="Parkstory — Concept B · Technological Disruption"
  description={shift.lead}
  bodyClass="cb"
  current="technological-disruption"
>
  <header class="cb-nav">
    <a href="#top" class="cb-mark" aria-label="Parkstory, back to top"><ParkstoryMark /></a>
    <p>TilePark · A new architecture for automated parking</p>
    <a href="#decision" class="cb-nav-cta">Briefing</a>
  </header>

  <main id="top">
    <!-- 01 THE SHIFT -->
    <section class="cb-hero" id="shift">
      <div class="cb-field" aria-hidden="true">
        <div class="cb-field-plane"><TileField cell={58} density={0.84} rate={9} accentShare={0.16} /></div>
      </div>
      <div class="cb-hero-shade" aria-hidden="true"></div>
      <div class="cb-wrap cb-hero-in">
        <ParkstoryMark variant="swarm" class="cb-word" />
        <p class="cb-kicker cb-rise" style="--d:.6s">TilePark · A new architecture for automated parking</p>
        <h1 class="cb-rise" style="--d:.7s">
          <span>Tomorrow’s infrastructure</span>
          <span>cannot run on</span>
          <span><span class="cb-outline">yesterday’s</span> technology.</span>
        </h1>
        <div class="cb-hero-foot cb-rise" style="--d:.9s">
          <p class="cb-lead">{shift.lead}</p>
          <a href="#question" class="cb-scroll">Scroll<i></i></a>
        </div>
      </div>
    </section>

    <section class="cb-points">
      <div class="cb-wrap">
        <p class="cb-intro" data-reveal>{shift.intro}</p>
        <ol>
          {
            shift.points.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${0.1 * i}s`}>
                <span>{p.n}</span>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 02 THE QUESTION -->
    <section class="cb-question" id="question">
      <div class="cb-sticky">
        <div class="cb-wrap">
          <p class="cb-kicker">02 / {question.eyebrow}</p>
          <h2 class="cb-q" data-words>
            {questionWords.map((w) => <span>{w} </span>)}
          </h2>
        </div>
      </div>
    </section>

    <section class="cb-sec cb-tight">
      <div class="cb-wrap">
        <p class="cb-body" data-reveal>{question.body}</p>
        <ol class="cb-rows">
          {
            question.constraints.map((c) => (
              <li data-reveal>
                <b>{constraintWord[c.k] ?? c.k}</b>
                <div>
                  <span>{c.k}</span>
                  <p>{c.v}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="cb-timeline">
          <p class="cb-kicker">A decision measured in decades</p>
          <DecadeTimeline />
          <p class="cb-note">{question.timeline.note}</p>
        </div>
      </div>
    </section>

    <!-- 03 THE BREAKTHROUGH -->
    <section class="cb-cinema" id="breakthrough">
      <video src="/videos/realvid.mp4" autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
      <div class="cb-cinema-shade" aria-hidden="true"></div>
      <div class="cb-wrap cb-cinema-in">
        <p class="cb-kicker" data-reveal>03 / {breakthrough.eyebrow}</p>
        <h2 class="cb-h2" data-reveal>
          Not a better machine.<br /><span class="cb-lime">A different architecture.</span>
        </h2>
        <p class="cb-tag">Real footage · TilePark in operation, Munich</p>
      </div>
    </section>

    <section class="cb-sec">
      <div class="cb-wrap">
        <p class="cb-body" data-reveal>{breakthrough.body}</p>
        <p class="cb-swarm" data-reveal>
          Hundreds of independent conveyors. No central control. <span>One shared goal:</span> getting your car to you by
          the shortest route.
        </p>
        <ol class="cb-principles">
          {
            breakthrough.principles.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                <span>{p.n}</span>
                <h3>{p.k}</h3>
                <p>{p.v}</p>
              </li>
            ))
          }
        </ol>
        <div class="cx-demos"><GridDemo /></div>
        <p class="cb-note">{breakthrough.patent}</p>
      </div>
    </section>

    <!-- 04 THE ECONOMICS OF CHANGE -->
    <section class="cb-sec cb-econ" id="economics">
      <div class="cb-wrap">
        <p class="cb-kicker" data-reveal>04 / {economics.eyebrow}</p>
        <h2 class="cb-h2" data-reveal>{economics.title}</h2>

        <div class="cb-big" data-reveal>
          <p class="cb-big-cap">Same grid. Same 297 m². {economics.example.caption}</p>
          <div class="cb-big-row">
            {
              ex.map((r, i) => (
                <div class:list={['cb-big-cell', { hi: i === ex.length - 1 }]}>
                  <b>{r.cars}</b>
                  <span>cars</span>
                  <p>{r.config}</p>
                  <em>{r.perCar} per car</em>
                </div>
              ))
            }
          </div>
          <details class="cb-assume">
            <summary>Assumptions behind these numbers</summary>
            <ol>{economics.example.assumptions.map((a) => <li>{a}</li>)}</ol>
          </details>
        </div>

        <ul class="cb-levers">
          {
            economics.levers.map((l, i) => (
              <li data-reveal style={`--reveal-delay:${0.05 * i}s`}>
                <h3>{l.k}</h3>
                <p>{l.v}</p>
              </li>
            ))
          }
        </ul>
        <div class="cx-demos"><StackerDemo /></div>
      </div>
    </section>

    <!-- 05 BUILT FOR WHAT COMES NEXT -->
    <section class="cb-sec" id="next">
      <div class="cb-wrap">
        <p class="cb-kicker" data-reveal>05 / {next.eyebrow}</p>
        <h2 class="cb-h2" data-reveal>{next.title}</h2>
        <p class="cb-body" data-reveal>{next.body}</p>
        <div class="cb-lanes">
          {
            [
              ['Today', next.today, 'today'],
              ['In development', next.developing, 'dev'],
              ['Future direction', next.future, 'future'],
            ].map(([label, items, cls], i) => (
              <div class:list={['cb-lane', `is-${cls}`]} data-reveal style={`--reveal-delay:${0.1 * i}s`}>
                <p class="cb-badge">{label as string}</p>
                {(items as { k: string; v: string }[]).map((it) => (
                  <div class="cb-lane-item">
                    <h3>{it.k}</h3>
                    <p>{it.v}</p>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
        <div class="cx-demos cb-ev"><EvDemo /></div>
      </div>
    </section>

    <!-- 06 ENGINEERING HERITAGE -->
    <section class="cb-sec cb-heritage" id="heritage">
      <div class="cb-wrap">
        <p class="cb-kicker" data-reveal>06 / {heritage.eyebrow}</p>
        <h2 class="cb-h2" data-reveal>
          We design what we build.<br /><span class="cb-lime">We build what we develop.</span>
        </h2>
        <div class="cb-collage">
          {
            [
              [drives, 'TilePark conveyor drive assembly, Gastonia', 'big'],
              [welding, 'Robotic welding, Kehl', ''],
              [bending, 'CNC bending, Kehl', ''],
              [cnc, 'CNC machining, Gastonia', ''],
            ].map(([img, cap, cls], i) => (
              <figure class={cls as string} data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                <Image
                  src={img as ImageMetadata}
                  alt={cap as string}
                  widths={[500, 900]}
                  sizes="(max-width: 760px) 100vw, 50vw"
                />
                <figcaption>{cap as string}</figcaption>
              </figure>
            ))
          }
        </div>
        <div class="cb-her-copy">
          {heritage.body.map((b) => <p data-reveal>{b}</p>)}
        </div>
        <dl class="cb-facts">
          {
            heritage.facts.map((f, i) => (
              <div data-reveal style={`--reveal-delay:${0.05 * i}s`}>
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="cb-flow" data-reveal>
          {
            heritage.flow.map((s, i) => (
              <span>
                {s}
                {i < heritage.flow.length - 1 && <i>→</i>}
              </span>
            ))
          }
        </p>
      </div>
    </section>

    <!-- 07 THE DECISION -->
    <section class="cb-decision" id="decision">
      <div class="cb-wrap">
        <p class="cb-kicker">07 / The decision</p>
        <h2 data-reveal>{decision.title}</h2>
        <div class="cb-decision-row">
          <p data-reveal>{decision.body}</p>
          <div class="cb-ctas" data-reveal>
            <a href={decision.ctaHref} class="cb-btn">{decision.cta}</a>
            <a href={decision.secondaryHref} target="_blank" rel="noopener" class="cb-btn cb-btn--ghost"
              >{decision.secondary}</a
            >
          </div>
        </div>
        <p class="cb-aud">For {decision.audience.join(' · ')}</p>
      </div>
    </section>
  </main>

  <footer class="cb-foot">
    <div class="cb-wrap">
      <span class="cb-mark"><ParkstoryMark /></span>
      <p>Designed, programmed and built by Parkstory in Kehl, Germany, and Gastonia, USA.</p>
    </div>
  </footer>

  <script>
    // The navigation logo appears once the big hero wordmark has scrolled away.
    const word = document.querySelector('.cb-word');
    const nav = document.querySelector('.cb-nav');
    if (word && nav) {
      new IntersectionObserver((es) => nav.classList.toggle('show-mark', !es[0].isIntersecting)).observe(word);
    }

    // Scroll-driven word highlight for the central question.
    const q = document.querySelector<HTMLElement>('[data-words]');
    const sec = document.querySelector<HTMLElement>('.cb-question');
    if (q && sec) {
      const words = [...q.querySelectorAll('span')];
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const update = () => {
        const r = sec.getBoundingClientRect();
        const total = r.height - innerHeight;
        const p = reduce ? 1 : Math.min(1, Math.max(0, -r.top / Math.max(1, total * 0.8)));
        const n = Math.round(p * words.length);
        words.forEach((w, i) => w.classList.toggle('lit', i < n));
      };
      update();
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
    }
  </script>
</ConceptLayout>

<style is:global>
  html:root {
    /* Parkstory CI colours (from Parkstory's own artwork) */
    --black: #040d09;
    --ink-2: #07150f;
    --lift: #0f261b;
    --line: #18291f;
    --white: #ffffff;
    --grey: #a2beb0;
    --soft: #c5d9cf;
    --lime: #b8f03c;
    --mint: #5ee3a1;
    --amber: #f5a524;
    --cond: 'Archivo Variable', 'Arial Narrow', sans-serif;
    /* demo theme */
    --tp-accent: #b8f03c;
    --tp-accent-soft: #b8f03c;
    --tp-accent-wash: rgb(184 240 60 / 15%);
    --tp-panel: #07150f;
    --tp-panel-2: #0f261b;
    --tp-board: #040d09;
    --tp-line: rgb(255 255 255 / 8%);
    --tp-line-2: rgb(255 255 255 / 18%);
    --tp-text-dim: #a2beb0;
    --tp-text-soft: #c5d9cf;
    --tp-warn: #f5a524;
    --cx-radius: 0;
    --cx-radius-sm: 0;
    --cx-btn-radius: 0;
    --cx-btn-bg: #b8f03c;
    --cx-btn-fg: #07150f;
    --cx-font: var(--cond);
    --cx-font-display: var(--cond);
    --cx-font-mono: var(--cond);
    --cx-tile: #1f3a2c;
  }
  .cb {
    background: var(--black);
    color: var(--white);
    font-family: var(--cond);
    font-stretch: 100%;
    font-size: 17px;
    line-height: 1.55;
  }
  .cb ::selection {
    background: var(--lime);
    color: var(--black);
  }
  .cb-wrap {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 64px);
  }
  .cb-lime {
    color: var(--lime);
  }
  .cb-kicker {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .cb h1,
  .cb-h2,
  .cb-q,
  .cb-decision h2,
  .cb-rows b,
  .cb-big-cell b,
  .cb-principles span {
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  /* nav */
  .cb-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 18px clamp(20px, 4vw, 64px);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background: linear-gradient(rgb(4 13 9 / 85%), transparent);
  }
  .cb-mark {
    text-decoration: none;
    font-size: 30px;
    text-transform: none;
    letter-spacing: 0;
  }
  .cb-nav .cb-mark {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition:
      opacity 0.4s,
      transform 0.4s;
  }
  .cb-nav p {
    transition: opacity 0.4s;
  }
  .cb-nav:not(.show-mark) p {
    opacity: 0;
  }
  .cb-nav {
    transition: background 0.4s;
  }
  .cb-nav.show-mark {
    background: rgb(4 13 9 / 92%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .cb-nav.show-mark .cb-mark {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .cb-word {
    font-size: clamp(3.6rem, min(11vw, 17vh), 11rem);
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
  }
  .cb-swarm {
    margin-top: clamp(56px, 7vw, 104px);
    font-family: 'Outfit Variable', 'Outfit', sans-serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 3.6vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    max-width: 26ch;
  }
  .cb-swarm span {
    color: var(--lime);
  }
  .cb-nav p {
    color: var(--grey);
  }
  .cb-nav-cta {
    text-decoration: none;
    border: 1px solid var(--white);
    padding: 0.55rem 1rem;
  }
  .cb-nav-cta:hover {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--black);
  }
  @media (max-width: 760px) {
    .cb-nav p {
      display: none;
    }
  }

  /* hero */
  .cb-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .cb-field {
    position: absolute;
    inset: 0;
    perspective: 1100px;
    perspective-origin: 50% 0%;
  }
  .cb-field-plane {
    position: absolute;
    left: -30%;
    right: -30%;
    top: 18%;
    height: 140%;
    transform: rotateX(58deg);
    transform-origin: 50% 0%;
    --tf-bg: #040d09;
    --tf-line: rgb(255 255 255 / 8%);
    --tf-car: #24443a;
    --tf-car-2: #173025;
    --tf-glass: rgb(0 0 0 / 55%);
    --tf-accent: #b8f03c;
  }
  .cb-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, #040d09 0%, rgb(4 13 9 / 70%) 28%, rgb(4 13 9 / 15%) 55%, rgb(4 13 9 / 85%) 100%),
      radial-gradient(80% 60% at 50% 70%, transparent, rgb(4 13 9 / 60%));
  }
  .cb-hero-in {
    position: relative;
    width: 100%;
    padding-top: 96px;
    padding-bottom: clamp(32px, 6vh, 64px);
  }
  .cb h1 {
    font-size: clamp(2.6rem, min(6.4vw, 9.5vh), 8.5rem);
    line-height: 0.86;
    margin: 1.25rem 0 2.5rem;
  }
  .cb h1 > span {
    display: block;
  }
  .cb-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--white);
  }
  .cb-hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }
  .cb-lead {
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    max-width: 36ch;
    line-height: 1.35;
    color: var(--soft);
  }
  .cb-scroll {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .cb-scroll i {
    width: 1px;
    height: 48px;
    background: linear-gradient(var(--lime), transparent);
    animation: cbDrop 2s ease-in-out infinite;
  }
  @keyframes cbDrop {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  .cb-rise {
    animation: cbRise 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes cbRise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  /* points */
  .cb-points {
    padding: clamp(80px, 10vw, 160px) 0;
    border-bottom: 1px solid var(--line);
  }
  .cb-intro {
    font-size: clamp(1.4rem, 2.6vw, 2.4rem);
    line-height: 1.2;
    max-width: 34ch;
    letter-spacing: -0.01em;
  }
  .cb-points ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: clamp(56px, 7vw, 112px);
  }
  .cb-points li {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
  .cb-points span {
    color: var(--lime);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
  }
  .cb-points li p {
    margin-top: 0.75rem;
    font-size: 1.3rem;
    line-height: 1.25;
    max-width: 22ch;
  }

  /* question */
  .cb-question {
    height: 170vh;
    position: relative;
  }
  .cb-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
  }
  .cb-q {
    font-size: clamp(2.8rem, 8vw, 9rem);
    line-height: 0.9;
    margin-top: 1.5rem;
    max-width: 16ch;
  }
  .cb-q span {
    color: #14261d;
    transition: color 0.35s;
  }
  .cb-q span.lit {
    color: var(--white);
  }
  .cb-q span.lit:nth-last-child(-n + 2) {
    color: var(--lime);
  }

  /* generic sections */
  .cb-sec {
    padding: clamp(96px, 12vw, 200px) 0;
  }
  .cb-tight {
    padding-top: 0;
  }
  .cb-h2 {
    font-size: clamp(2.6rem, 7vw, 7.5rem);
    line-height: 0.9;
    margin-top: 1.25rem;
    max-width: 16ch;
  }
  .cb-body {
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    line-height: 1.4;
    max-width: 46ch;
    color: var(--soft);
    margin-top: 2rem;
  }
  .cb-note {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    color: var(--grey);
    max-width: 72ch;
  }
  .cb-rows {
    margin-top: clamp(64px, 8vw, 120px);
    border-top: 1px solid var(--line);
  }
  .cb-rows li {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .cb-rows b {
    font-size: clamp(3rem, 9vw, 8.5rem);
    line-height: 0.85;
    color: #0f2018;
    -webkit-text-stroke: 1px #2a4637;
    transition: color 0.4s;
  }
  .cb-rows li:hover b {
    color: var(--lime);
    -webkit-text-stroke-color: var(--lime);
  }
  .cb-rows span {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lime);
  }
  .cb-rows p {
    font-size: 1.15rem;
    margin-top: 0.4rem;
    max-width: 38ch;
  }
  .cb-timeline {
    margin-top: clamp(96px, 12vw, 160px);
    --dt-ink: #ffffff;
    --dt-muted: #a2beb0;
