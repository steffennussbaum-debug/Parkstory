  <script>
    // The navigation logo appears once the big hero wordmark has scrolled away.
    const word = document.querySelector('.cb-word');
    const nav = document.querySelector('.cb-nav');
    if (word && nav) {
      new IntersectionObserver((es) => nav.classList.toggle('show-mark', !es[0].isIntersecting)).observe(word);
    }

    // Highlight the chapter currently on screen in the navigation.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.cb-chapters a')];
    const byId = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.toggle('on', a === byId.get(e.target.id)));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    document.querySelectorAll('main section[id]').forEach((sec) => io.observe(sec));

    // Scroll-driven word highlight for the central question.
    const q = document.querySelector<HTMLElement>('[data-words]');
    const sec = document.querySelector<HTMLElement>('.cb-question');
    if (q && sec) {
      const words = [...q.querySelectorAll('span')];
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const update = () => {
        const r = sec.getBoundingClientRect();
        const total = r.height - innerHeight;
        const p = reduce ? 1 : Math.min(1, Math.max(0, -r.top / Math.max(1, total * 0.8)));
        const n = Math.round(p * words.length);
        words.forEach((w, i) => w.classList.toggle('lit', i < n));
      };
      update();
      addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
    }
  </script>
