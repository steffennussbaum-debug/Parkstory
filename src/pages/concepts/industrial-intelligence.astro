---
/**
 * Concept C — Industrial Intelligence.
 * Premium European engineering: graphite and paper, IBM Plex Sans with Plex
 * Mono technical labels, specification-sheet layouts, crop-marked figures and
 * one safety-orange signal colour. Precision manufacturing meets software.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ConceptLayout from '~/layouts/ConceptLayout.astro';
import TileField from '~/components/concepts/TileField.astro';
import SectionDrawing from '~/components/concepts/SectionDrawing.astro';
import DecadeTimeline from '~/components/concepts/DecadeTimeline.astro';
import RealVideo from '~/components/tilepark/RealVideo.astro';
import GridDemo from '~/components/tilepark/GridDemo.astro';
import StackerDemo from '~/components/tilepark/StackerDemo.astro';
import { shift, question, breakthrough, economics, next, heritage, decision } from '~/data/concepts';

import conveyors from '~/assets/images/tilepark/conveyors-installed.webp';
import kehlPlant from '~/assets/images/tilepark/kehl-plant.webp';
import gastPlant from '~/assets/images/tilepark/gastonia-plant.webp';
import welding from '~/assets/images/tilepark/kehl-welding.webp';
import steel from '~/assets/images/tilepark/kehl-steel.webp';
import drives from '~/assets/images/tilepark/gastonia-drive-assembly.webp';

import '@fontsource/ibm-plex-sans/300.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '~/assets/styles/tilepark.css';
import '~/assets/styles/concept-demos.css';

const sec = (n: number, label: string) => ({ n: String(n).padStart(2, '0'), label });
const S = [
  sec(1, 'System shift'),
  sec(2, 'The question'),
  sec(3, 'Architecture'),
  sec(4, 'Economics'),
  sec(5, 'Roadmap'),
  sec(6, 'Manufacturing'),
  sec(7, 'Decision'),
];
const status = [
  ...next.today.map((i) => ({ ...i, code: 'LIVE', cls: 'live' })),
  ...next.developing.map((i) => ({ ...i, code: 'DEV', cls: 'dev' })),
  ...next.future.map((i) => ({ ...i, code: 'DIRECTION', cls: 'dir' })),
];
const stations = [
  { s: heritage.flow[0], img: null },
  { s: heritage.flow[1], img: null },
  { s: heritage.flow[2], img: steel },
  { s: heritage.flow[3], img: welding },
  { s: heritage.flow[4], img: drives },
  { s: heritage.flow[5], img: null },
  { s: heritage.flow[6], img: null },
  { s: heritage.flow[7], img: null },
];
---

<ConceptLayout
  title="Parkstory — Concept C · Industrial Intelligence"
  description={shift.lead}
  bodyClass="cc"
  current="industrial-intelligence"
>
  <header class="cc-nav">
    <a href="#top" class="cc-mark"><span class="cc-sq"></span>Parkstory</a>
    <nav aria-label="Sections">
      {
        S.slice(2, 6).map((s, i) => (
          <a href={['#breakthrough', '#economics', '#next', '#heritage'][i]}>
            <i>{s.n}</i>
            {s.label}
          </a>
        ))
      }
    </nav>
    <a href="#decision" class="cc-nav-cta">Technology briefing</a>
  </header>

  <main id="top">
    <!-- 01 SYSTEM SHIFT -->
    <section class="cc-hero" id="shift">
      <div class="cc-hero-text">
        <p class="cc-tag" data-reveal>[{S[0].n}] {S[0].label} — {shift.eyebrow}</p>
        <h1 data-reveal style="--reveal-delay:.08s">
          Tomorrow’s infrastructure cannot run on yesterday’s technology<span class="cc-o">.</span>
        </h1>
        <p class="cc-lead" data-reveal style="--reveal-delay:.16s">{shift.lead}</p>
        <div class="cc-hero-ctas" data-reveal style="--reveal-delay:.24s">
          <a href="#breakthrough" class="cc-btn">Examine the architecture</a>
          <a href="#decision" class="cc-btn cc-btn--line">Request a briefing</a>
        </div>
      </div>
      <figure class="cc-hero-fig">
        <Image
          src={conveyors}
          alt="TilePark conveyors with their drives, installed in an underground garage"
          widths={[800]}
          sizes="(max-width: 960px) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="cc-grid-overlay" aria-hidden="true"></div>
        <span class="cc-crop tl"></span><span class="cc-crop tr"></span><span class="cc-crop bl"></span><span
          class="cc-crop br"></span>
        <figcaption>FIG. 01 — TILEPARK XY TRANSPORT LEVEL, INSTALLED</figcaption>
        <div class="cc-live">
          <div class="cc-live-head"><i></i>Live model · decentralised routing</div>
          <div class="cc-live-field"><TileField cell={22} density={0.82} rate={14} accentShare={0.25} /></div>
        </div>
      </figure>
    </section>

    <section class="cc-spec">
      <div class="cc-wrap">
        <p class="cc-intro" data-reveal>{shift.intro}</p>
        <ol>
          {
            shift.points.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${0.08 * i}s`}>
                <span>{p.n}</span>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- 02 THE QUESTION -->
    <section class="cc-sec cc-paper" id="question">
      <div class="cc-wrap">
        <div class="cc-head" data-reveal><span>[{S[1].n}]</span>{S[1].label}<em>SEC {S[1].n} / 07</em></div>
        <div class="cc-two">
          <h2 class="cc-h2" data-reveal>{question.title}</h2>
          <p class="cc-body" data-reveal>{question.body}</p>
        </div>
        <table class="cc-table" data-reveal>
          <thead><tr><th>Parameter</th><th>Constraint in conventional layouts</th></tr></thead>
          <tbody>
            {
              question.constraints.map((c, i) => (
                <tr>
                  <td>
                    <span class="cc-code">P{String(i + 1).padStart(2, '0')}</span>
                    {c.k}
                  </td>
                  <td>{c.v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <div class="cc-drawing" data-reveal>
          <p class="cc-fig">FIG. 02 — SECTION COMPARISON</p>
          <SectionDrawing />
        </div>
        <div class="cc-timeline">
          <p class="cc-fig">FIG. 03 — A DECISION MEASURED IN DECADES</p>
          <DecadeTimeline />
          <p class="cc-note">{question.timeline.note}</p>
        </div>
      </div>
    </section>

    <!-- 03 ARCHITECTURE -->
    <section class="cc-sec" id="breakthrough">
      <div class="cc-wrap">
        <div class="cc-head" data-reveal><span>[{S[2].n}]</span>{S[2].label}<em>SEC {S[2].n} / 07</em></div>
        <div class="cc-two">
          <h2 class="cc-h2" data-reveal>{breakthrough.title}</h2>
          <p class="cc-body" data-reveal>{breakthrough.body}</p>
        </div>
        <ol class="cc-modules">
          {
            breakthrough.principles.map((p, i) => (
              <li data-reveal style={`--reveal-delay:${0.07 * i}s`}>
                <span class="cc-code">PRINCIPLE {p.n}</span>
                <h3>{p.k}</h3>
                <p>{p.v}</p>
              </li>
            ))
          }
        </ol>
        <div class="cx-demos cc-demos">
          <RealVideo />
          <GridDemo />
        </div>
        <p class="cc-note">{breakthrough.patent}</p>
      </div>
    </section>

    <!-- 04 ECONOMICS -->
    <section class="cc-sec cc-paper" id="economics">
      <div class="cc-wrap">
        <div class="cc-head" data-reveal><span>[{S[3].n}]</span>{S[3].label}<em>SEC {S[3].n} / 07</em></div>
        <div class="cc-two">
          <h2 class="cc-h2" data-reveal>{economics.title}</h2>
          <p class="cc-body" data-reveal>{economics.body}</p>
        </div>
        <ol class="cc-levers">
          {
            economics.levers.map((l, i) => (
              <li data-reveal style={`--reveal-delay:${0.05 * i}s`}>
                <span class="cc-code">E{String(i + 1).padStart(2, '0')}</span>
                <h3>{l.k}</h3>
                <p>{l.v}</p>
              </li>
            ))
          }
        </ol>
        <div class="cc-sheet" data-reveal>
          <div class="cc-sheet-head">
            <span>DATA SHEET — {economics.example.title.toUpperCase()}</span>
            <span>{economics.example.caption}</span>
          </div>
          <table class="cc-table cc-table--num">
            <thead>
              <tr><th>Configuration</th><th>Cars</th><th>m² / car</th><th>Clear height</th></tr>
            </thead>
            <tbody>
              {
                economics.example.rows.map((r) => (
                  <tr>
                    <td>{r.config}</td>
                    <td>{r.cars}</td>
                    <td>{r.perCar.replace(' m²', '')}</td>
                    <td>{r.height}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          <ol class="cc-assume">
            {
              economics.example.assumptions.map((a, i) => (
                <li>
                  <span>A{i + 1}</span>
                  {a}
                </li>
              ))
            }
          </ol>
        </div>
        <div class="cx-demos cc-demos"><StackerDemo /></div>
      </div>
    </section>

    <!-- 05 ROADMAP -->
    <section class="cc-sec" id="next">
      <div class="cc-wrap">
        <div class="cc-head" data-reveal><span>[{S[4].n}]</span>{next.eyebrow}<em>SEC {S[4].n} / 07</em></div>
        <div class="cc-two">
          <h2 class="cc-h2" data-reveal>{next.title}</h2>
          <p class="cc-body" data-reveal>{next.body}</p>
        </div>
        <div class="cc-legend" data-reveal>
          <span class="live">LIVE — available today</span><span class="dev">DEV — in development</span><span class="dir"
            >DIRECTION — not a current feature</span
          >
        </div>
        <table class="cc-matrix" data-reveal>
          <tbody>
            {
              status.map((s) => (
                <tr class={s.cls}>
                  <td>
                    <span class="cc-status">{s.code}</span>
                  </td>
                  <th>{s.k}</th>
                  <td>{s.v}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- 06 MANUFACTURING -->
    <section class="cc-sec cc-paper" id="heritage">
      <div class="cc-wrap">
        <div class="cc-head" data-reveal><span>[{S[5].n}]</span>{heritage.eyebrow}<em>SEC {S[5].n} / 07</em></div>
        <div class="cc-two">
          <h2 class="cc-h2" data-reveal>{heritage.title}</h2>
          <div class="cc-body">{heritage.body.map((b) => <p data-reveal>{b}</p>)}</div>
        </div>
        <ol class="cc-line" aria-label="From design to service">
          {
            stations.map((st, i) => (
              <li data-reveal style={`--reveal-delay:${0.05 * i}s`}>
                <div class="cc-line-img">
                  {st.img ? (
                    <Image src={st.img} alt={st.s} widths={[300]} sizes="160px" />
                  ) : (
                    <span>{['ENG', 'CODE', '', '', '', 'LOAD RIG', 'SITE', '30+ YRS'][i]}</span>
                  )}
                </div>
                <span class="cc-code">ST {String(i + 1).padStart(2, '0')}</span>
                <b>{st.s}</b>
              </li>
            ))
          }
        </ol>
        <dl class="cc-facts">
          {
            heritage.facts.map((f, i) => (
              <div data-reveal style={`--reveal-delay:${0.05 * i}s`}>
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </div>
            ))
          }
        </dl>
        <div class="cc-plants">
          {
            [
              [kehlPlant, 'PLANT DE — KEHL, GERMANY'],
              [gastPlant, 'PLANT US — GASTONIA, NORTH CAROLINA'],
            ].map(([img, cap]) => (
              <figure data-reveal>
                <Image
                  src={img as ImageMetadata}
                  alt={cap as string}
                  widths={[600, 1000]}
                  sizes="(max-width: 760px) 100vw, 50vw"
                />
                <span class="cc-crop tl" />
                <span class="cc-crop br" />
                <figcaption>{cap as string}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 07 DECISION -->
    <section class="cc-decision" id="decision">
      <div class="cc-wrap">
        <div class="cc-head"><span>[{S[6].n}]</span>{S[6].label}<em>SEC {S[6].n} / 07</em></div>
        <h2 data-reveal>{decision.title}</h2>
        <div class="cc-two">
          <p class="cc-body" data-reveal>{decision.body}</p>
          <div class="cc-hero-ctas" data-reveal>
            <a href={decision.ctaHref} class="cc-btn">{decision.cta}</a>
            <a href={decision.secondaryHref} target="_blank" rel="noopener" class="cc-btn cc-btn--line"
              >{decision.secondary}</a
            >
          </div>
        </div>
        <p class="cc-aud">{decision.audience.map((a) => <span>{a}</span>)}</p>
      </div>
    </section>
  </main>

  <footer class="cc-foot">
    <div class="cc-wrap">
      <span class="cc-mark"><span class="cc-sq"></span>Parkstory</span>
      <p>Designed, programmed and built by Parkstory in Kehl, Germany, and Gastonia, USA.</p>
      <p class="cc-code">EP 3924576 B1</p>
    </div>
  </footer>
</ConceptLayout>

<style is:global>
  html:root {
    --graphite: #141618;
    --graphite-2: #1d2023;
    --graphite-3: #2a2e32;
    --paper: #e9e8e4;
    --paper-2: #dfdeda;
    --white: #fafaf8;
    --steel: #8d9297;
    --orange: #ff5b1f;
    --cc-line-d: rgb(255 255 255 / 10%);
    --cc-line-l: rgb(20 22 24 / 14%);
    --sans: 'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    /* demo theme */
    --tp-accent: #ff5b1f;
    --tp-accent-soft: #ff8a5c;
    --tp-accent-wash: rgb(255 91 31 / 16%);
    --tp-panel: #1d2023;
    --tp-panel-2: #26292d;
    --tp-board: #111315;
    --tp-line: rgb(255 255 255 / 9%);
    --tp-line-2: rgb(255 255 255 / 18%);
    --tp-text-dim: #8d9297;
    --tp-text-soft: #c9ccd0;
    --cx-radius: 0;
    --cx-radius-sm: 0;
    --cx-btn-radius: 0;
    --cx-btn-bg: #ff5b1f;
    --cx-btn-fg: #141618;
    --cx-font: var(--sans);
    --cx-font-display: var(--sans);
    --cx-font-mono: var(--mono);
    --cx-tile: #33383d;
  }
  .cc {
    background: var(--graphite);
    color: var(--white);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
  }
  .cc ::selection {
    background: var(--orange);
    color: var(--graphite);
  }
  .cc-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px, 3.5vw, 56px);
  }
  .cc-o {
    color: var(--orange);
  }
  .cc-code,
  .cc-tag,
  .cc-fig {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cc-code {
    color: var(--orange);
  }

  /* nav */
  .cc-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 60px;
    padding: 0 clamp(20px, 3.5vw, 56px);
    background: rgb(20 22 24 / 88%);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--cc-line-d);
    font-size: 0.85rem;
  }
  .cc-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-size: 1.05rem;
    text-decoration: none;
  }
  .cc-sq {
    width: 12px;
    height: 12px;
    background: var(--orange);
  }
  .cc-nav nav {
    display: flex;
    gap: 1.75rem;
  }
  .cc-nav nav a {
    text-decoration: none;
    color: #c9ccd0;
  }
  .cc-nav nav a:hover {
    color: #fff;
  }
  .cc-nav nav i {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--steel);
    margin-right: 0.4rem;
  }
  .cc-nav-cta {
    text-decoration: none;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid var(--orange);
    color: var(--orange);
    padding: 0.5rem 0.9rem;
  }
  .cc-nav-cta:hover {
    background: var(--orange);
    color: var(--graphite);
  }
  @media (max-width: 1000px) {
    .cc-nav nav {
      display: none;
    }
  }

  /* hero */
  .cc-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100svh;
    padding-top: 60px;
    border-bottom: 1px solid var(--cc-line-d);
  }
  .cc-hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(48px, 7vw, 112px) clamp(20px, 3.5vw, 56px);
    background-image:
      linear-gradient(var(--cc-line-d) 1px, transparent 1px),
      linear-gradient(90deg, var(--cc-line-d) 1px, transparent 1px);
    background-size: 80px 80px;
    background-position: -1px -1px;
  }
  .cc-tag {
    color: var(--steel);
  }
  .cc h1 {
    font-weight: 500;
    font-size: clamp(2.5rem, 4.9vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 1.5rem 0 1.75rem;
    max-width: 15ch;
  }
  .cc-lead {
    font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    font-weight: 300;
    color: #c9ccd0;
    max-width: 40ch;
    line-height: 1.45;
  }
  .cc-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  .cc-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    background: var(--orange);
    color: var(--graphite);
    font-weight: 500;
    padding: 0.95rem 1.4rem;
    font-size: 0.95rem;
    transition: background 0.2s;
  }
  .cc-btn::after {
    content: '→';
    font-family: var(--mono);
  }
  .cc-btn:hover {
    background: #ff7a45;
  }
  .cc-btn--line {
    background: transparent;
    color: inherit;
    border: 1px solid currentColor;
  }
  .cc-btn--line:hover {
    background: transparent;
    color: var(--orange);
  }
  .cc-hero-fig {
    position: relative;
    overflow: hidden;
    background: #000;
    min-height: 420px;
  }
  .cc-hero-fig img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 60%;
    filter: grayscale(0.85) contrast(1.08) brightness(0.85);
  }
  .cc-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 9%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 9%) 1px, transparent 1px);
    background-size: 80px 80px;
    background-position: -1px -1px;
  }
  .cc-crop {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 0 solid var(--orange);
  }
  .cc-crop.tl {
    top: 20px;
    left: 20px;
    border-top-width: 1.5px;
    border-left-width: 1.5px;
  }
  .cc-crop.tr {
    top: 20px;
    right: 20px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
  }
  .cc-crop.bl {
    bottom: 20px;
    left: 20px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
  }
  .cc-crop.br {
    bottom: 20px;
    right: 20px;
    border-bottom-width: 1.5px;
    border-right-width: 1.5px;
  }
  .cc-hero-fig figcaption {
    position: absolute;
    left: 52px;
    top: 24px;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: #fff;
  }
  .cc-live {
    position: absolute;
    right: 52px;
    bottom: 52px;
    width: min(300px, 60%);
    background: rgb(20 22 24 / 92%);
    border: 1px solid var(--cc-line-d);
  }
  .cc-live-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--cc-line-d);
    color: #c9ccd0;
  }
  .cc-live-head i {
    width: 7px;
    height: 7px;
    background: var(--orange);
    border-radius: 50%;
    animation: ccBlink 1.6s infinite;
  }
  @keyframes ccBlink {
    50% {
      opacity: 0.25;
    }
  }
  .cc-live-field {
    height: 170px;
    --tf-bg: #141618;
    --tf-line: rgb(255 255 255 / 9%);
    --tf-car: #5b6167;
    --tf-car-2: #41464b;
    --tf-glass: rgb(0 0 0 / 45%);
    --tf-accent: #ff5b1f;
  }

  /* spec strip */
  .cc-spec {
    padding: clamp(72px, 9vw, 136px) 0;
  }
  .cc-intro {
    font-size: clamp(1.3rem, 2.2vw, 2rem);
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 44ch;
  }
  .cc-spec ol {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(48px, 6vw, 88px);
    border-top: 1px solid var(--cc-line-d);
  }
